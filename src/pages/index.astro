  </main>

  <script>
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* Los renglones del titular suben al montar y no al entrar en pantalla:
       están sobre el pliegue y el H1 es el candidato a LCP. Colgarlos del
       observador costaría el primer render. */
    requestAnimationFrame(() => document.getElementById("portada")?.classList.add("cargado"));

    /* La escena fija. El avance dentro de la sección decide cuántos renglones
       van encendidos: una regla de tres sobre su rectángulo, sin librerías. */
    const escena = document.getElementById("escena");
    const renglones = [...document.querySelectorAll("#renglones .renglon")];
    const cuenta = document.getElementById("cuenta-escena");

    if (escena && renglones.length) {
      if (quieto) {
        renglones.forEach((el) => el.classList.add("activo"));
      } else {
        const pinta = () => {
          const r = escena.getBoundingClientRect();
          const recorrido = r.height - window.innerHeight;
          const p = recorrido > 0 ? Math.min(1, Math.max(0, -r.top / recorrido)) : 1;
          /* Los cuatro se reparten en el 85% del recorrido, para que el último
             alcance a leerse antes de que la sección se despegue. */
          const activos = Math.min(renglones.length, Math.floor((p / 0.85) * renglones.length) + 1);
          renglones.forEach((el, i) => el.classList.toggle("activo", i < activos));
          if (cuenta) cuenta.textContent = String(activos).padStart(2, "0");
        };
        let pedido = false;
        addEventListener(
          "scroll",
          () => {
            if (pedido) return;
            pedido = true;
            requestAnimationFrame(() => {
              pinta();
              pedido = false;
            });
          },
          { passive: true },
        );
        pinta();
      }
    }

    /* ---------- La galería de las seis puertas ---------- */
    const pista = document.getElementById("pista");
    const carril = document.getElementById("carril");
    const barra = document.getElementById("barra-pista");
    const barraCaja = document.getElementById("barra-caja");
    const guiaPista = document.getElementById("guia-pista");
    const cuentaPista = document.getElementById("pista-cuenta");

    if (pista && carril && barra && barraCaja && guiaPista) {
      const puertas = pista.querySelectorAll(".puerta");
      const total = String(puertas.length).padStart(2, "0");

      pista.addEventListener(
        "scroll",
        () => {
          const max = pista.scrollWidth - pista.clientWidth;
          const p = max > 0 ? pista.scrollLeft / max : 0;
          barra.style.width = p * 100 + "%";

          /* Qué tarjeta manda: la primera que arranca DENTRO del carril, no la
             primera que asoma. Con el borde derecho la cuenta se quedaba en 01
             hasta el final, porque en escritorio la primera tarjeta sigue
             asomando 90px cuando ya vas en la última. Se mide contra el DOM y
             no dividiendo el scroll entre un ancho supuesto, porque las
             tarjetas cambian de ancho con el viewport. */
          if (cuentaPista && puertas.length) {
            const izq = pista.getBoundingClientRect().left;
            let i = puertas.length - 1;
            for (let n = 0; n < puertas.length; n++) {
              if (puertas[n].getBoundingClientRect().left >= izq - 24) {
                i = n;
                break;
              }
            }
            cuentaPista.textContent = `${String(i + 1).padStart(2, "0")} / ${total}`;
          }
          /* En cuanto se mueve, la barra deja de ser señal y pasa a ser avance. */
          if (pista.scrollLeft > 4) {
            barraCaja.classList.add("movida");
            guiaPista.classList.add("movida");
          }
          carril.classList.toggle("al-final", p > 0.98);
        },
        { passive: true },
      );

      /* Arrastre con el mouse. En táctil no hace falta: el gesto es nativo. */
      let abajo = false;
      let x0 = 0;
      let s0 = 0;
      pista.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse") return;
        abajo = true;
        x0 = e.clientX;
        s0 = pista.scrollLeft;
        pista.classList.add("arrastrando");
      });
      addEventListener("pointerup", () => {
        abajo = false;
        pista.classList.remove("arrastrando");
      });
      pista.addEventListener("pointermove", (e) => {
        if (abajo) pista.scrollLeft = s0 - (e.clientX - x0);
      });

      /* Teclado: la región es enfocable, así que las flechas tienen que moverla. */
      pista.addEventListener("keydown", (e) => {
        const puerta = pista.querySelector(".puerta");
        if (!puerta) return;
        const paso = puerta.getBoundingClientRect().width + 19;
        if (e.key === "ArrowRight") {
          pista.scrollBy({ left: paso, behavior: "smooth" });
          e.preventDefault();
        }
        if (e.key === "ArrowLeft") {
          pista.scrollBy({ left: -paso, behavior: "smooth" });
          e.preventDefault();
        }
      });

      /* El empujón: la primera vez que la galería entra en pantalla el carril
         se asoma 22px y regresa. Es la forma más corta de decir "esto se
         mueve" sin quitarle el control a nadie, y por eso pasa UNA vez. */
      if (!quieto) {
        const ioEmpuje = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              ioEmpuje.disconnect();
              setTimeout(() => {
                if (pista.scrollLeft > 4) return;
                pista.scrollTo({ left: 22, behavior: "smooth" });
                setTimeout(() => pista.scrollTo({ left: 0, behavior: "smooth" }), 420);
              }, 500);
            }
          },
          { threshold: 0.5 },
        );
        ioEmpuje.observe(pista);
      }
    }
  </script>
</BaseLayout>

<style>
  .margen {
    position: relative;
  }
  /* El filete de margen iba en un hex crudo (#d9e3f0), que era un azul frío
     heredado de la identidad anterior y sobre el papel cálido se veía morado.
     Va en token, como manda la regla del sistema. */
  .margen::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.5rem;
    border-left: 1px solid var(--color-line);
  }
  @media (max-width: 900px) {
    .margen::before {
      display: none;
    }
  }
  section {
    padding: 4.2rem 0;
  }
  h1 {
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.15rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 22ch;
    margin: 1.1rem 0 0;
  }
  /* Solo el título del lead magnet: los demás h2 son folios de sección */
  .guia-titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }
  h3 {
    margin: 0;
  }

  /* Portada */
  /*
     Llena la primera pantalla completa. Se resta el alto del header (73px,
     medido) porque es sticky y ocupa espacio en el flujo. svh y no vh, para
     que la barra del navegador en móvil no la desborde.
  */
  .portada {
    position: relative;
    min-height: calc(100svh - 4.6rem);
    display: grid;
    align-content: center;
    padding: 4rem 0 5rem;
  }
  /* La entrada de categoría, en el registro de F: mono en versalitas con una
     raya que la ancla al margen. Sustituye a la cápsula con palomita. */
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
  }
  .kicker span {
    width: 2.4rem;
    height: 1px;
    background: var(--color-ink-dim);
    flex: none;
  }
  .portada-titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.9rem, 8.4vw, 6.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 1.6rem 0 0;
    max-width: 15ch;
  }
  .portada-titulo em {
    font-style: italic;
  }
  .portada-titulo b {
    font-weight: 400;
  }
  /* La banda del plumón se calibra para la serif: su altura de equis es más
     baja que la de la sans, así que el alto de texto corrido se le queda
     debajo y lee como subrayado. Medido sobre el render, no sobre el código. */
  .portada-titulo .hl {
    --hl-abajo: 0.22em;
    --hl-alto: 0.5em;
  }
  .portada-pie {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem 3rem;
    align-items: end;
    margin-top: 3rem;
  }
  @media (max-width: 900px) {
    .portada-pie {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  .hero-sub {
    margin: 0;
    max-width: 44ch;
    color: var(--color-ink-soft);
    font-size: 1.12rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* La señal de "sigue bajando". Va a la orilla derecha y no al centro: la
     columna de texto llega hasta la mitad y ahí se encimaba. */
  .baja {
    position: absolute;
    bottom: 1.6rem;
    right: 2.5rem;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
  }
  .baja i {
    display: block;
    width: 1px;
    height: 2.4rem;
    background: linear-gradient(var(--color-ink-dim), transparent);
    animation: cae 2.2s ease-in-out infinite;
  }
  @keyframes cae {
    0%,
    100% {
      transform: scaleY(0.4);
      transform-origin: top;
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }
  @media (max-width: 900px) {
    .baja {
      display: none;
    }
  }

  /* ---------- La escena fija ----------
     Tres pantallas de recorrido para cuatro renglones. El alto es lo que
     compra el tiempo de lectura: con menos, los cuatro se encienden de golpe
     y se pierde el efecto de ir asentando uno por uno. */
  .escena {
    position: relative;
    height: 320vh;
    padding: 0;
  }
  .escena-fija {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-content: center;
    overflow: hidden;
  }
  .escena-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .escena-titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 4.4vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0.9rem 0 0;
    max-width: 14ch;
  }
  .escena-apunte {
    margin: 1.2rem 0 0;
    max-width: 38ch;
    color: var(--color-ink-soft);
  }
  .escena-cuenta {
    margin: 1.6rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--color-ink-dim);
  }
  .escena-cuenta b {
    color: var(--color-accent);
  }
  .escena-prueba {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .caras {
    display: flex;
    align-items: center;
  }
  .caras img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-bg);
    margin-left: -10px;
  }
  .caras img:first-child {
    margin-left: 0;
  }
  .caras b {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink);
  }

  .renglones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .renglon {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.1rem;
    align-items: center;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.05rem 1.2rem;
    /*
     * Estado en espera. NO se hace con opacity, aunque sea lo obvio: a 0.28 el
     * texto quedaba en 1.44:1 contra el fondo (Lighthouse lo marcó), y para
     * pasar AA la opacidad tendría que subir a 0.92, con lo que ya no se
     * distinguiría del estado encendido. Se calculó, no se estimó.
     *
     * Lo que sí funciona: la fila espera sobre el papel y ENCIENDE al blanco,
     * con la sombra y el filete entrando a la vez. Los dos estados tienen
     * contraste de sobra y el gesto se lee mejor, porque la tarjeta se
     * prende en vez de desvanecerse.
     */
    background: var(--color-surface);
    transform: translateY(10px) scale(0.985);
    transition:
      background 0.45s var(--ease-f),
      color 0.45s var(--ease-f),
      transform 0.45s var(--ease-f),
      box-shadow 0.45s,
      border-color 0.45s;
  }
  .renglon h3,
  .renglon .dato {
    color: var(--color-ink-soft);
    transition: color 0.45s var(--ease-f);
  }
  .renglon .marca {
    color: var(--color-ink-dim);
    background: transparent;
    transition:
      color 0.45s var(--ease-f),
      background 0.45s var(--ease-f);
  }
  .renglon.activo {
    background: var(--color-surface-raised);
    transform: none;
    box-shadow: 0 18px 40px -26px rgb(20 22 26 / 0.5);
    border-color: color-mix(in oklab, var(--color-line) 60%, var(--color-ink-dim));
  }
  .renglon.activo h3 {
    color: var(--color-ink);
  }
  .renglon h3 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .renglon p {
    font-size: 0.82rem;
    color: var(--color-ink-dim);
    line-height: 1.4;
    margin: 0.15rem 0 0;
  }
  .renglon .dato {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .renglon.activo.ia .dato {
    color: var(--color-accent);
  }
  .renglon.tu {
    border-color: var(--color-line-strong);
  }
  .renglon.activo.tu .dato {
    color: var(--color-ink);
  }
  .marca {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1.5px solid currentColor;
    flex: none;
  }
  .marca svg {
    width: 12px;
    height: 12px;
  }
  /* Verde cuando lo cerró la máquina, tinta cuando lo cerraste tú. Ese
     contraste es el argumento del bloque y no se toca. */
  .renglon.activo.ia .marca {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .renglon.activo.tu .marca {
    color: var(--color-ink);
    background: var(--color-bg);
  }
  @media (max-width: 980px) {
    .escena {
      height: 280vh;
    }
    .escena-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .escena-prueba {
      display: none;
    }
  }
  /* Sin animación no hay escena que recorrer: la sección se vuelve una
     sección normal, con los cuatro renglones puestos. */
  @media (prefers-reduced-motion: reduce) {
    .escena {
      height: auto;
    }
    .escena-fija {
      position: static;
      height: auto;
      padding: 4.2rem 0;
    }
    .renglon {
      transform: none;
      transition: none;
    }
  }

  /* Quién soy */
  /* Una sola columna de lectura. A dos columnas dentro de un contenedor de
     74rem cada una queda en 33rem, que son unos 90 caracteres por renglón:
     demasiado para leer cómodo. El ancho de lectura manda sobre la retícula. */
  .bio-grid {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }
  .figura {
    margin: 3.5rem 0 0;
  }
  .pie-figura {
    margin: 1rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-marker);
    font-family: var(--font-mono);

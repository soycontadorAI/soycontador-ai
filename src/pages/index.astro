  .testimonio-video {
    position: sticky;
    top: 6rem;
  }
  /* La objeción entra en gris y en cursiva, como en la vuelta: es la voz de
     antes. Va en color, no en opacidad, por la misma razón de contraste. */
  .testimonio-antes {
    margin: 0 0 0.9rem;
    font-family: var(--font-serif-detail);
    font-style: italic;

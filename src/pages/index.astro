---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LeadForm from "../components/LeadForm.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Poliza from "../components/Poliza.astro";
import Terminal from "../components/Terminal.astro";
import { FAQ_HOME } from "../lib/faqs";
import { faqPage, graph, person, webSite } from "../lib/schema";
import { EBOOK, SITE } from "../lib/site";

const jsonLd = graph(person(), webSite(), faqPage(FAQ_HOME, `${SITE.url}/`));

const asientos = [
  {
    num: "01",
    titulo: "Capacitación en IA",
    texto:
      "Ocho horas en vivo y en grupo chico, para que te dé tiempo de atorarte y preguntar. Sales con tu primer proceso automatizado funcionando, no con apuntes. Es la misma forma de trabajar con la que un solo diagnóstico destapó más de $11 millones en saldos a favor que llevaban años ahí.",
    href: "/capacitacion",
    cta: "calendario →",
  },
  {
    num: "02",
    titulo: "¿Prefieres que yo lo haga?",
    texto:
      "Me traes el proceso que odias y te lo quito. El concentrado mensual de un cliente tomaba siete horas de captura. Hoy corre solo mientras desayunas.",
    href: "/soluciones",
    cta: "platícame →",
  },
  {
    num: "03",
    titulo: "Herramientas que ya funcionan",
    texto:
      "TodoConta: descarga masiva de CFDI, constancias y opinión 32-D en un clic. Más la conexión con Claude para trabajar tus XML por un canal controlado, sin pegarlos en un chat público.",
    href: "/herramientas",
    cta: "conoce →",
  },
  {
    num: "04",
    titulo: `Ebook: ${EBOOK.titulo}`,
    texto: `Diecisiete capítulos y tres apéndices para entender la IA antes de que la IA te rebase. Cero código. Cero palabras raras sin explicar. Si después de leerlo sigues sin entender de qué va esto, te devuelvo tus ${EBOOK.precio.replace("$", "$").replace(" MXN", "")}.`,
    href: EBOOK.url ?? "/contacto",
    cta: "consíguelo →",
  },
  {
    num: "05",
    titulo: "Jueves de ContadorIA",
    texto:
      "Cada jueves a las 11:00 del centro. Un problema real de un despacho real, resuelto en pantalla, sin cortes y sin que me salga a la primera. Gratis.",
    href: "/jueves",
    cta: "suscríbete →",
  },
  {
    num: "06",
    titulo: "Club de Automatización Fiscal",
    texto:
      "Membresía anual con lugares contados. Software, un bootcamp de implementación cada mes, y alguien que te contesta cuando te atoras a las 11 de la noche de un día 16. No entra cualquiera y no es barato.",
    href: "/club",
    cta: "aplica →",
  },
];

const lineasTerminal = [
  { tipo: "user" as const, texto: "concilia los CFDI de marzo contra el estado de cuenta" },
  { tipo: "dim" as const, texto: "→ mcp: todoconta · leyendo 3,412 XML…" },
  { tipo: "ok" as const, texto: "✓ 3,398 conciliados · 14 diferencias detectadas" },
  { tipo: "ok" as const, texto: "✓ reporte listo en 31 segundos" },
  { tipo: "dim" as const, texto: "# la máquina hizo las 3,398 fáciles. las 14 difíciles son tuyas." },
  { tipo: "dim" as const, texto: "# por eso no te reemplaza." },
];
---

<BaseLayout jsonLd={jsonLd}>
  <main>
    <section class="hero">
      <div class="container-default margen hero-grid">
        <div>
          <p class="eyebrow">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2.5 8.8 6 12.2 13.5 3.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            IA para contadores de carrera
          </p>
          <h1>Los recién egresados ya traen el chip.<br />Tú cuentas con algo mejor, <span class="hl">experiencia</span></h1>
          <p class="hero-sub">
            La IA se aprende en una tarde. Saber cuándo un número miente, en veinte
            años. Tú ya pagaste la parte cara. Ponle la herramienta encima y los
            rebasas por la derecha.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#contacto">Platiquemos de tu caso</a>
            <a class="btn btn-ghost" href="/jueves">Ve el live de los jueves</a>
          </div>
          <p class="hero-micro">
            Sin costo. Me cuentas en qué se te va la vida y yo te digo si tengo cómo resolverlo.
          </p>
        </div>
        <div>
          <Poliza
            animada
            folio="PÓLIZA Dr-002"
            titulo="RECLASIFICACIÓN DE TU TIEMPO"
            columnaCargo="Cargo"
            columnaAbono="Abono"
            filas={[
              { concepto: "Criterio y asesoría", cargo: "20 h/mes" },
              { concepto: "Descargas manuales del SAT", abono: "8 h/mes", detalle: true },
              { concepto: "Validaciones y listas negras", abono: "5 h/mes", detalle: true },
              { concepto: "Capturas y reportes en Excel", abono: "7 h/mes", detalle: true },
            ]}
            total={{ concepto: "Sumas iguales", cargo: "20 h/mes", abono: "20 h/mes" }}
            nota="// no se creó tiempo. se cambió de cuenta."
            foto="/assets/israel-castro.jpg"
            fotoAlt="Israel Castro"
          />
        </div>
      </div>
    </section>

    <section id="quien">
      <div class="container-default margen">
        <div class="sec-head"><h2 class="folio">CUENTA <b>01</b> · QUIÉN TE ESTÁ HABLANDO</h2></div>
        <div class="bio-grid">
          <div class="bio" data-reveal>
            <p class="lede">Soy contador público. Y desarrollador de software.</p>
            <p>
              Empecé capturando pólizas y peleándome con el portal del SAT, igual que
              tú. +10 años de fiscal. Cierres, revisiones, clientes que te mandan
              todo un día antes del vencimiento.
            </p>
            <p>
              En algún punto me dio curiosidad el otro lado y me puse a estudiar
              programación. Terminé trabajando como desarrollador en una startup. Hoy
              estoy de regreso en el despacho, automatizando todo lo que se repite.
            </p>
            <p>
              Y aquí está la parte que importa para ti: <strong>hoy no escribo
              código. Lo leo, lo entiendo, y se lo pido a la IA en los términos
              correctos.</strong>
            </p>
            <p>
              Esa es la habilidad que te quiero pasar. No la de programar. La de saber
              nombrar el problema. <span class="hl">Tu experiencia contable</span> más esa habilidad no la
              alcanza ningún recién egresado, por mucho chip que traiga.
            </p>
            <div class="chips">
              <span class="chip"><b>15</b> años de fiscal</span>
              <span class="chip">TodoConta · desde <b>2012</b></span>
              <span class="chip">MCP <b>SAT</b></span>
              <span class="chip">Live semanal · <b>jueves 11:00</b></span>
            </div>
            <p class="mas"><a href="/sobre-mi">Toda la historia →</a></p>
          </div>
          <div data-reveal style="--reveal-delay: .12s">
            <Terminal lineas={lineasTerminal} />
          </div>
        </div>
      </div>
    </section>

    <section id="ofertas">
      <div class="container-default margen">
        <div class="sec-head"><h2 class="folio">CUENTA <b>02</b> · QUÉ ENCUENTRAS AQUÍ</h2></div>
        <div class="asientos" data-reveal>
          {asientos.map((a) => (
            <a class="asiento" href={a.href}>
              <span class="num">{a.num}</span>
              <span>
                <h3>{a.titulo}</h3>
                <p>{a.texto}</p>
              </span>
              <span class="go">{a.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cita">
      <div class="container-default" data-reveal>
        <span class="folio">ASIENTO DE CIERRE</span>
        <blockquote>
          Nadie contrata veinte años de criterio en un recién egresado.<br />
          Y lo que no tiene sustituto, <span class="hl">no se regatea</span>.
        </blockquote>
      </div>
    </section>

    <section class="guia">
      <div class="container-default guia-inner">
        <div>
          <p class="folio guia-folio">DESCARGA <b>GRATUITA</b></p>
          <h2 class="guia-titulo">5 prompts para auditar tus XMLs con Claude</h2>
          <p class="guia-texto">
            No salieron de un blog gringo. Salieron del sistema de auditoría
            preventiva que corre en mi despacho: cuatro capas de revisión, más el
            reporte que le entregas al cliente.
          </p>
          <ul class="guia-capas">
            <li>Validación formal del lote (Anexo 20)</li>
            <li>Materialidad de operaciones</li>
            <li>Scoring de riesgo con semáforo, al estilo del SAT</li>
            <li>Blindaje de proveedores (69-B y REPSE)</li>
            <li>El reporte ejecutivo que sí puedes cobrar</li>
          </ul>
          <p class="guia-texto">
            Los copias, los pegas y los usas hoy mismo. Te los mando al correo, junto
            con una idea de IA fiscal cada semana.
          </p>
        </div>
        <div>
          <NewsletterForm boton="Mándame los prompts" nota="Sin spam. Te das de baja con un clic y sin resentimientos." />
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">CUENTA <b>03</b> · PREGUNTAS DIRECTAS</h2></div>
        <FaqBlock items={FAQ_HOME} />
      </div>
    </section>

    <section class="bandos">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">LA <b>PARTIDA DOBLE</b></h2></div>
        <div class="bandos-cuerpo" data-reveal>
          <p class="bandos-entrada">Hay dos despachos con los mismos años encima.</p>
          <div class="bandos-par">
            <article class="bando bando-a">
              <p class="folio">DESPACHO <b>A</b></p>
              <p>
                Se siguen bajando los XMLs de uno en uno. Ahí saben que hay
                herramientas, pero no ha habido tiempo de ver cuáles. Cada año
                cobran lo mismo, cada año cuesta un poco más, y cada tanto se pierde
                un cliente que se fue con alguien "más moderno". No es que sepan
                menos. Es que hacen manual lo que ya se resuelve solo.
              </p>
            </article>
            <article class="bando bando-b">
              <p class="folio">DESPACHO <b>B</b></p>
              <p>
                Dedicaron unas semanas a aprender a pedirle cosas a la máquina. Ahora
                entregan en la mañana lo que antes tomaba dos días, cobran por el
                criterio y no por las horas, y sus clientes ya no saben cómo operar
                sin ellos.
              </p>
            </article>
          </div>
          <p class="bandos-remate">
            Mismos años. Mismo conocimiento fiscal. Lo
            que cambió fue una decisión, y no fue una decisión difícil.
          </p>
          <p class="bandos-filtro">
            Si crees que la IA es una moda pasajera, no me hagas caso y
            espérate. Si buscas resolverlo todo con un prompt mientras tú no
            haces nada, tampoco es aquí. Esto multiplica lo que ya sabes hacer. Si no
            sabes hacer nada, no hay qué multiplicar.
          </p>
        </div>
      </div>
    </section>

    <section class="cierre">
      <div class="container-default" data-reveal>
        <LeadForm />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .margen {
    position: relative;
  }
  .margen::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.5rem;
    border-left: 1px solid #d9e3f0;
  }
  @media (max-width: 900px) {
    .margen::before {
      display: none;
    }
  }
  section {
    padding: 4.2rem 0;
  }
  h1 {
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.15rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 22ch;
    margin: 1.1rem 0 0;
  }
  /* Solo el título del lead magnet: los demás h2 son folios de sección */
  .guia-titulo {
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }
  h3 {
    margin: 0;
  }

  /* Hero */
  .hero {
    padding: 5rem 0 4rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero-sub {
    margin-top: 1.4rem;
    max-width: 50ch;
    color: var(--color-ink-soft);
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* Quién soy */
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .bio-grid {
      grid-template-columns: 1fr;
    }
  }
  .bio p {
    margin: 0 0 1.1rem;
    color: var(--color-ink-soft);
  }
  .bio p strong {
    color: var(--color-ink);
  }
  .bio .lede {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.45;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface-raised);
    color: var(--color-ink-soft);
  }
  .chip b {
    color: var(--color-accent);
    font-weight: 700;
  }
  .mas {
    margin-top: 1.3rem;
  }
  .mas a {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Asientos */
  .asientos {
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .asiento {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.7rem 1.8rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .asiento:last-child {
    border-bottom: none;
  }
  .asiento:hover {
    background: var(--color-accent-soft);
  }
  .asiento .num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink-dim);
  }
  .asiento:hover .num {
    color: var(--color-accent);
  }
  .asiento h3 {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .asiento p {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    margin: 0.3rem 0 0;
    max-width: 58ch;
  }
  .asiento .go {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .asiento {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .asiento .num {
      font-size: 1.1rem;
    }
  }

  /* Cita */
  .cita {
    text-align: center;
    padding: 5rem 0;
  }
  .cita blockquote .hl {
    --hl-alto: 0.62em;
  }
  .cita blockquote {
    font-family: var(--font-serif-detail);
    font-style: italic;
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    line-height: 1.35;
    max-width: 26ch;
    margin: 1.2rem auto 0;
    color: var(--color-ink);
  }

  /* Lead magnet */
  .guia {
    background: var(--color-line-strong);
  }
  .guia-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 760px) {
    .guia-inner {
      grid-template-columns: 1fr;
    }
  }
  .guia .guia-folio {
    color: #8da2c0;
  }
  .guia .guia-folio b {
    color: var(--color-terminal-ok);
  }
  .guia .guia-titulo {
    color: #ffffff;
    margin: 0.8rem 0;
  }
  .guia-texto {
    color: #aebbd1;
    max-width: 46ch;
    margin: 0;
  }

  .cierre {
    padding-bottom: 5rem;
  }

  /* Eyebrow del hero: ancla de categoría, no cápsula de plantilla.
     Capitular normal, gris medio, sin fondo ni tracking abierto, y con aire
     generoso antes del H1: ese espacio es la mitad de por qué no se ve a
     plantilla. El icono va gris, nunca en el verde de acción. */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.92rem;
    font-weight: 400;
    color: var(--color-ink-dim);
  }
  .eyebrow svg {
    flex: none;
    color: var(--color-ink-dim);
  }
  .hero h1 {
    margin-top: 2.6rem;
    max-width: 24ch;
    /* Reparte las líneas en vez de dejar una huérfana: el titular es el golpe
       de la página y un renglón de dos palabras lo desinfla. */
    text-wrap: balance;
  }
  @media (max-width: 900px) {
    .hero h1 {
      margin-top: 1.6rem;
    }
  }
  .hero-micro {
    margin: 1.1rem 0 0;
    max-width: 46ch;
    font-size: 0.88rem;
    color: var(--color-ink-dim);
  }

  /* El marcador del titular no cuelga del observador: está sobre el pliegue y
     el H1 es el candidato a LCP. Se pinta solo al cargar, medio segundo
     después, que es más o menos cuando el ojo llega a la última palabra.

     La banda sube a 0.68em porque el alto por defecto está calibrado para
     texto corrido: a 50px se quedaba bajo las letras y leía como subrayado
     grueso. A esta altura tapa la equis y vuelve a leer como plumón. */
  .hero h1 .hl {
    --hl-alto: 0.68em;
    transition: none;
    animation: hl-pinta 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.55s backwards;
  }
  @keyframes hl-pinta {
    from {
      background-size: 0 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero h1 .hl {
      animation: none;
    }
  }

  /* Dos bandos: la elección, narrada. */
  .bandos-entrada {
    margin: 0 0 1.6rem;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .bandos-par {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  @media (max-width: 760px) {
    .bandos-par {
      grid-template-columns: 1fr;
    }
  }
  .bando {
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }
  .bando-b {
    border-color: var(--color-line-strong);
    box-shadow: 6px 6px 0 var(--color-accent-soft);
  }
  .bando p:last-child {
    margin: 0.7rem 0 0;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }
  .bandos-remate {
    margin: 1.8rem 0 0;
    font-size: 1.06rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .bandos-filtro {
    margin: 1.6rem 0 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--color-line);
    font-size: 0.95rem;
    color: var(--color-ink-dim);
  }

  /* Las capas del lead magnet van en lista: que se puedan contar es la mitad
     del valor percibido de un imán gratuito. */
  .guia-capas {
    list-style: none;
    margin: 1.1rem 0;
    padding: 0;
  }
  .guia-capas li {
    position: relative;
    padding: 0.4rem 0 0.4rem 1.5rem;
    font-size: 0.95rem;
    color: #c9d6e8;
  }
  .guia-capas li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--color-terminal-ok);
    font-family: var(--font-mono);
  }

  /* Dos bandos dibujado como cuenta T: es el isotipo de la marca hecho
     sección. El cargo a la izquierda en tinta, el abono a la derecha en verde,
     y la raya vertical que los separa. La lectura es la tesis: la IA no es un
     total al pie, es la contrapartida que completa el asiento.

     Se anima el orden, no el adorno: entra A, hay un beat, entra B y solo
     entonces se enciende el verde. Lo único que cambió fue una decisión. */
  .bandos-par {
    position: relative;
    border-top: 2px solid var(--color-line-strong);
    padding-top: 1.4rem;
    gap: 0;
  }
  .bandos-par::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--color-line-strong);
    transform-origin: top;
  }
  .bando {
    border: none;
    border-radius: 0;
    background: none;
    padding: 0 1.6rem;
  }
  .bando-b {
    box-shadow: none;
  }
  .bando-b .folio :global(b) {
    color: var(--color-accent);
  }
  @media (max-width: 760px) {
    .bandos-par {
      gap: 1.6rem;
    }
    /* En vertical la raya del medio no separa nada: se convierte en el filete
       lateral de cada bando. */
    .bandos-par::before {
      display: none;
    }
    .bando {
      padding: 0 0 0 1.2rem;
      border-left: 2px solid var(--color-line);
    }
    .bando-b {
      border-left-color: var(--color-accent);
    }
  }

  .is-visible .bandos-par::before {
    animation: traza-eje 0.6s ease-out 0.2s backwards;
  }

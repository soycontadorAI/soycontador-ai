---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LeadForm from "../components/LeadForm.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Pila from "../components/Pila.astro";
import Terminal from "../components/Terminal.astro";
import { FAQ_HOME } from "../lib/faqs";
import { faqPage, graph, person, webSite } from "../lib/schema";
import { EBOOK, SITE } from "../lib/site";

const jsonLd = graph(person(), webSite(), faqPage(FAQ_HOME, `${SITE.url}/`));

const asientos = [
  {
    num: "01",
    titulo: "Capacitación en IA",
    texto:
      "Ocho horas en vivo y en grupo chico, para que te dé tiempo de atorarte y preguntar. Sales con tu primer proceso automatizado funcionando, no con apuntes. Es la misma forma de trabajar con la que un solo diagnóstico destapó más de $11 millones en saldos a favor que llevaban años ahí.",
    href: "/capacitacion",
    cta: "calendario →",
  },
  {
    num: "02",
    titulo: "¿Prefieres que yo lo haga?",
    texto:
      "Me traes el proceso que odias y te lo quito. El concentrado mensual de un cliente tomaba siete horas de captura. Hoy corre solo mientras desayunas.",
    href: "/soluciones",
    cta: "platícame →",
  },
  {
    num: "03",
    titulo: "Herramientas que ya funcionan",
    texto:
      "TodoConta: descarga masiva de CFDI, constancias y opinión 32-D en un clic. Más la conexión con Claude para trabajar tus XML por un canal controlado, sin pegarlos en un chat público.",
    href: "/herramientas",
    cta: "conoce →",
  },
  {
    num: "04",
    titulo: `Ebook: ${EBOOK.titulo}`,
    texto: `Diecisiete capítulos y tres apéndices para entender la IA antes de que la IA te rebase. Cero código. Cero palabras raras sin explicar. Si después de leerlo sigues sin entender de qué va esto, te devuelvo tus ${EBOOK.precio.replace("$", "$").replace(" MXN", "")}.`,
    href: EBOOK.url ?? "/contacto",
    cta: "consíguelo →",
  },
  {
    num: "05",
    titulo: "Jueves de ContadorIA",
    texto:
      "Cada jueves a las 11:00 del centro. Un problema real de un despacho real, resuelto en pantalla, sin cortes y sin que me salga a la primera. Gratis.",
    href: "/jueves",
    cta: "suscríbete →",
  },
  {
    num: "06",
    titulo: "Club de Automatización Fiscal",
    texto:
      "Membresía anual con lugares contados. Software, un bootcamp de implementación cada mes, y alguien que te contesta cuando te atoras a las 11 de la noche de un día 16. No entra cualquiera y no es barato.",
    href: "/club",
    cta: "aplica →",
  },
];

const lineasTerminal = [
  { tipo: "user" as const, texto: "concilia los CFDI de marzo contra el estado de cuenta" },
  { tipo: "dim" as const, texto: "→ mcp: todoconta · leyendo 3,412 XML…" },
  { tipo: "ok" as const, texto: "✓ 3,398 conciliados · 14 diferencias detectadas" },
  { tipo: "ok" as const, texto: "✓ reporte listo en 31 segundos" },
  { tipo: "dim" as const, texto: "# la máquina hizo las 3,398 fáciles. las 14 difíciles son tuyas." },
];
---

<BaseLayout jsonLd={jsonLd}>
  <main>
    <section class="hero">
      <div class="container-default margen hero-grid">
        <div>
          <p class="eyebrow">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2.5 8.8 6 12.2 13.5 3.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            IA para contadores de carrera
          </p>
          <h1>La IA cierra las fáciles.<br />Las difíciles <span class="junto">las cobras <span class="hl">tú</span>.</span></h1>
          <p class="hero-sub">
            Descargar, validar y capturar ya se resuelve solo. Lo que no se
            resuelve solo es saber cuándo un número miente, y eso te tomó veinte
            años. Esa es la parte que se cobra.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#contacto">Platiquemos de tu caso</a>
            {/* El secundario es la salida sin compromiso, y por eso baja al
                menú en vez de mandar al live: quien todavía no quiere hablar
                necesita ver el rango completo, no una sola puerta. La cifra
                sale del arreglo para que el copy no pueda quedar mintiendo si
                mañana entra o sale un asiento. */}
            <a class="btn btn-ghost" href="#ofertas">Ve las {asientos.length} formas de empezar</a>
          </div>
          <p class="hero-micro">
            Sin costo. Me cuentas en qué se te va la vida y yo te digo si tengo cómo resolverlo.
          </p>
        </div>
        <div>
          <Pila
            tareas={[
              { hora: "08:14", titulo: "3,412 XML descargados", pie: "del portal del SAT, sin abrirlo", quien: "ia", dato: "31 s" },
              { hora: "08:15", titulo: "Validados contra 69 y 69-B", pie: "los 3,412, uno por uno", quien: "ia", dato: "0 riesgos" },
              { hora: "08:16", titulo: "Concentrado armado", pie: "el mismo de siempre, ya cuadrado", quien: "ia", dato: "4 hojas" },
              { hora: "08:31", titulo: "14 diferencias resueltas", pie: "esas no las decide la máquina", quien: "tu", dato: "tu criterio" },
            ]}
            remate="Cerraron el día antes de comer."
            personas={[
              { foto: "/assets/contadora-1.webp" },
              { foto: "/assets/contador-2.webp" },
              { foto: "/assets/contadora-3.webp" },
              {},
              {},
            ]}
            cuantos="+50"
          />
        </div>
      </div>
    </section>

    <!--
      El puente entre el titular y las secciones. Antes esto era la nota al pie
      completa, con la historia de la contadora de 46 años. La historia larga se
      fue, pero sin ella el titular se queda como afirmación sin respaldo: aquí
      queda la vuelta que la cerraba, que es la tesis del proyecto en tres
      frases. Termina en "de eso me encargo yo" y en seguida entra "quién te
      está hablando", que es exactamente la pregunta que deja abierta.
    -->
    <section class="vuelta">
      <div class="container-narrow" data-reveal>

        <blockquote>
          "Esto de la IA es para los más jóvenes, ya nacieron con el chip."
        </blockquote>

        <p class="vuelta-giro">De hecho, es al revés.</p>
        <p class="vuelta-texto">
          La IA es la herramienta más fácil de usar que se ha inventado. Se le
          habla en español y no hay que cursar una carrera, así que ahí la
          barrera es pareja para todos.
        </p>
        <p class="vuelta-texto">
          Lo que no es parejo es lo demás: nadie
          sale de la facultad sabiendo lidiar con la presión de que el cliente
          te mande todo a última hora, ni sabiendo leerle la cara al empresario
          que esconde esos otros ingresos.
        </p>
        <p class="vuelta-texto">
          A ti la parte fácil te llega encima de la parte difícil, que ya llevas
          años pagando. Quien debería estar preocupado no eres tú. Lo que te falta es método, no juventud.
        </p>
        <p class="vuelta-remate">Y de eso <span class="hl">me encargo yo</span>.</p>
      </div>
    </section>

    <section id="quien">
      <div class="container-default margen">
        <div class="sec-head"><h2 class="folio">CUENTA <b>01</b> · QUIÉN TE ESTÁ HABLANDO</h2></div>
        <div class="bio-grid">
          <div class="bio" data-reveal>
            <p class="lede">Soy contador público. Y desarrollador de software.</p>
            <p>
              Empecé capturando pólizas y peleándome con el portal del SAT, igual que
              tú. +10 años de fiscal. Cierres, revisiones, clientes que te mandan
              todo un día antes del vencimiento.
            </p>
            <p>
              En algún punto me dio curiosidad el otro lado y me puse a estudiar
              programación. Terminé trabajando como desarrollador en una startup. Hoy
              estoy de regreso en el despacho, automatizando todo lo que se repite.
            </p>
            <p>
              Y aquí está la parte que importa para ti: <strong>hoy no escribo
              código. Lo leo, lo entiendo, y se lo pido a la IA en los términos
              correctos.</strong>
            </p>
            <p>
              Esa es la habilidad que te quiero pasar. No la de programar. La de saber
              nombrar el problema. <span class="hl">Tu experiencia contable</span> más esa habilidad no la
              alcanza ningún recién egresado, por mucho chip que traiga.
            </p>
            <div class="chips">
              <span class="chip"><b>15</b> años de fiscal</span>
              <span class="chip">TodoConta · desde <b>2012</b></span>
              <span class="chip">MCP <b>SAT</b></span>
              <span class="chip">Live semanal · <b>jueves 11:00</b></span>
            </div>
            <p class="mas"><a href="/sobre-mi">Toda la historia →</a></p>
          </div>
          <div data-reveal style="--reveal-delay: .12s">
            <Terminal lineas={lineasTerminal} />
          </div>
        </div>
      </div>
    </section>

    <section id="ofertas">
      <div class="container-default margen">
        <div class="sec-head"><h2 class="folio">CUENTA <b>02</b> · QUÉ ENCUENTRAS AQUÍ</h2></div>
        <div class="asientos" data-reveal>
          {asientos.map((a) => (
            <a class="asiento" href={a.href}>
              <span class="num">{a.num}</span>
              <span>
                <h3>{a.titulo}</h3>
                <p>{a.texto}</p>
              </span>
              <span class="go">{a.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cita">
      <div class="container-default" data-reveal>
        <span class="folio">ASIENTO DE CIERRE</span>
        <blockquote>
          Nadie contrata veinte años de criterio en un recién egresado.<br />
          Y lo que no tiene sustituto, <span class="hl">no se regatea</span>.
        </blockquote>
      </div>
    </section>

    <!--
      El campo de correo va arriba, al lado de la promesa, y el detalle de las
      cinco capas baja a una tira. Antes el correo quedaba al final de una lista
      de cinco viñetas: quien ya había decidido tenía que leerlas todas para
      encontrar dónde dejarlo.
    -->
    <section class="guia">
      <div class="container-default guia-inner">
        <div>
          <p class="folio guia-folio">DESCARGA <b>GRATUITA</b></p>
          <h2 class="guia-titulo">5 prompts para auditar tus XMLs con Claude</h2>
          <p class="guia-texto">
            No salieron de un blog gringo. Salieron del sistema de auditoría
            preventiva que corre en mi despacho. Los copias, los pegas y los
            usas hoy mismo.
          </p>
        </div>
        <div class="guia-form">
          {/* Lo del boletín se dice AQUÍ y no en un párrafo aparte: el aviso de
              a qué te estás dando de alta tiene que estar donde se da el
              correo, no tres párrafos antes. */}
          <NewsletterForm
            boton="Mándame los prompts"
            nota="Te los mando al correo, junto con una idea de IA fiscal cada semana. Te das de baja con un clic."
          />
        </div>
      </div>
      <div class="container-default">
        <ul class="capas-tira" data-reveal>
          <li><b>01</b> Validación formal del lote (Anexo 20)</li>
          <li><b>02</b> Materialidad de operaciones</li>
          <li><b>03</b> Scoring de riesgo con semáforo, al estilo del SAT</li>
          <li><b>04</b> Blindaje de proveedores (69-B y REPSE)</li>
          <li><b>05</b> El reporte ejecutivo que sí puedes cobrar</li>
        </ul>
      </div>
    </section>

    <section id="faq">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">CUENTA <b>03</b> · PREGUNTAS DIRECTAS</h2></div>
        <FaqBlock items={FAQ_HOME} />
      </div>
    </section>

    <section class="bandos">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">LA <b>PARTIDA DOBLE</b></h2></div>
        <div class="bandos-cuerpo" data-reveal>
          <p class="bandos-entrada">Hay dos despachos con los mismos años encima.</p>
          <div class="bandos-par">
            <article class="bando bando-a">
              <p class="folio">DESPACHO <b>A</b></p>
              <p>
                Se siguen bajando los XMLs de uno en uno. Ahí saben que hay
                herramientas, pero no ha habido tiempo de ver cuáles. Cada año
                cobran lo mismo, cada año cuesta un poco más, y cada tanto se pierde
                un cliente que se fue con alguien "más moderno". No es que sepan
                menos. Es que hacen manual lo que ya se resuelve solo.
              </p>
            </article>
            <article class="bando bando-b">
              <p class="folio">DESPACHO <b>B</b></p>
              <p>
                Dedicaron unas semanas a aprender a pedirle cosas a la máquina. Ahora
                entregan en la mañana lo que antes tomaba dos días, cobran por el
                criterio y no por las horas, y sus clientes ya no saben cómo operar
                sin ellos.
              </p>
            </article>
          </div>
          <p class="bandos-remate">
            Mismos años. Mismo conocimiento fiscal. Lo
            que cambió fue una decisión, y no fue una decisión difícil.
          </p>
          <p class="bandos-filtro">
            Si crees que la IA es una moda pasajera, no me hagas caso y
            espérate. Si buscas resolverlo todo con un prompt mientras tú no
            haces nada, tampoco es aquí. Esto multiplica lo que ya sabes hacer. Si no
            sabes hacer nada, no hay qué multiplicar.
          </p>
        </div>
      </div>
    </section>

    <section class="cierre">
      <div class="container-default" data-reveal>
        <LeadForm />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .margen {
    position: relative;
  }
  .margen::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.5rem;
    border-left: 1px solid #d9e3f0;
  }
  @media (max-width: 900px) {
    .margen::before {
      display: none;
    }
  }
  section {
    padding: 4.2rem 0;
  }
  h1 {
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.15rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 22ch;
    margin: 1.1rem 0 0;
  }
  /* Solo el título del lead magnet: los demás h2 son folios de sección */
  .guia-titulo {
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }
  h3 {
    margin: 0;
  }

  /* Hero */
  .hero {
    padding: 5rem 0 4rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero-sub {
    margin-top: 1.4rem;
    max-width: 50ch;
    color: var(--color-ink-soft);
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* Quién soy */
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .bio-grid {
      grid-template-columns: 1fr;
    }
  }
  .bio p {
    margin: 0 0 1.1rem;
    color: var(--color-ink-soft);
  }
  .bio p strong {
    color: var(--color-ink);
  }
  .bio .lede {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.45;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface-raised);
    color: var(--color-ink-soft);
  }
  .chip b {
    color: var(--color-accent);
    font-weight: 700;
  }
  .mas {
    margin-top: 1.3rem;
  }
  .mas a {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Asientos */
  .asientos {
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .asiento {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.7rem 1.8rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .asiento:last-child {
    border-bottom: none;
  }
  .asiento:hover {
    background: var(--color-accent-soft);
  }
  .asiento .num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink-dim);
  }
  .asiento:hover .num {
    color: var(--color-accent);
  }
  .asiento h3 {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .asiento p {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    margin: 0.3rem 0 0;
    max-width: 58ch;
  }
  .asiento .go {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .asiento {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .asiento .num {
      font-size: 1.1rem;
    }
  }

  /* Cita */
  .cita {
    text-align: center;
    padding: 5rem 0;
  }
  .cita blockquote .hl {
    --hl-alto: 0.62em;
  }
  .cita blockquote {
    font-family: var(--font-serif-detail);
    font-style: italic;
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    line-height: 1.35;
    max-width: 26ch;
    margin: 1.2rem auto 0;
    color: var(--color-ink);
  }

  /* Lead magnet */
  .guia {
    background: var(--color-line-strong);
  }
  .guia-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 760px) {
    .guia-inner {
      grid-template-columns: 1fr;
    }
  }
  .guia .guia-folio {
    color: #8da2c0;
  }
  .guia .guia-folio b {
    color: var(--color-terminal-ok);
  }
  .guia .guia-titulo {
    color: #ffffff;
    margin: 0.8rem 0;
  }
  .guia-texto {
    color: #aebbd1;
    max-width: 46ch;
    margin: 0;
  }
  .guia-form {
    align-self: center;
  }

  /* La tira de capas: el detalle, debajo del correo y no encima. Que se puedan
     contar es la mitad del valor percibido de un imán gratuito, y numeradas en
     mono se cuentan de un vistazo. */
  .capas-tira {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    margin: 2.6rem 0 0;
    padding: 1.6rem 0 0;
    position: relative;
  }
  /* La raya de arriba es un pseudo-elemento y no un border para poder
     dibujarla con scaleX. Un border no se anima sin tocar el layout. */
  .capas-tira::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: #2a3648;
    transform-origin: left;
  }
  .capas-tira li {
    padding: 0 1.2rem 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: #9fb0c9;
  }
  .capas-tira b {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-terminal-ok);
  }
  /* En celular cinco columnas no caben, y apiladas hacen una torre de cinco
     renglones sueltos. Dos columnas: se siguen contando y ocupan la mitad. */
  @media (max-width: 760px) {
    .capas-tira {
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem 1.4rem;
      margin-top: 2.2rem;
    }
    .capas-tira li {
      padding-right: 0;
    }
    /* La quinta queda sola en su renglón: que ocupe el ancho completo en vez
       de dejar un hueco a la derecha. */
    .capas-tira li:last-child {
      grid-column: 1 / -1;
    }
  }

  /* La raya se traza y las capas caen sobre ella, en orden. Es entrada de
     scroll, no un flujo animado: por eso es corta (todo dentro en 0.9s) y
     cuelga del data-reveal que ya existe. */
  .is-visible.capas-tira::before {
    animation: traza-tira 0.55s ease-out backwards;
  }
  .is-visible.capas-tira li {
    animation: cae-capa 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  .is-visible.capas-tira li:nth-child(1) { animation-delay: 0.18s; }
  .is-visible.capas-tira li:nth-child(2) { animation-delay: 0.3s; }
  .is-visible.capas-tira li:nth-child(3) { animation-delay: 0.42s; }
  .is-visible.capas-tira li:nth-child(4) { animation-delay: 0.54s; }
  .is-visible.capas-tira li:nth-child(5) { animation-delay: 0.66s; }
  @keyframes traza-tira {
    from { transform: scaleX(0); }
  }
  @keyframes cae-capa {
    from { opacity: 0; transform: translate3d(0, 0.6rem, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-visible.capas-tira::before,
    .is-visible.capas-tira li {
      animation: none;
    }
  }

  .cierre {
    padding-bottom: 5rem;
  }

  /* Eyebrow del hero: ancla de categoría, no cápsula de plantilla.

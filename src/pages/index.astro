    color: var(--color-ink-soft);
    max-width: 48ch;
  }
  .testimonio-perfil a {
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }
  .testimonio-perfil a:hover,
  .testimonio-perfil a:focus-visible {
    text-decoration: underline;
  }
  .testimonio-contacto {
    margin-top: 0.8rem !important;
  }
  .testimonio-contacto a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }
  .testimonio-contacto a:hover,
  .testimonio-contacto a:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .testimonio-contacto svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  @media (max-width: 860px) {
    .testimonio {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .testimonio:nth-child(even of .testimonio) .testimonio-video {
      order: 0;
    }
    .testimonio-video {
      position: static;
    }
    .testimonio + .testimonio {
      margin-top: 3.5rem;
      padding-top: 3.5rem;
    }
  }

  /* La galería de las seis puertas */
  .galeria-titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 18ch;
  }
  .galeria-titulo em {
    font-style: italic;
  }

  .pista-guia {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }
  /*
     La misma barra hace dos trabajos: mientras nadie la ha movido es la SEÑAL
     (un segmento que viaja a la derecha, hermano de la línea de "Baja"), y en
     cuanto el lector arrastra se convierte en el avance real. Dos elementos
     distintos para lo mismo serían ruido.
  */
  .pista-barra {
    position: relative;
    flex: 1;
    max-width: 14rem;
    height: 2px;
    background: var(--color-line);
    border-radius: 99px;
    overflow: hidden;
  }
  .pista-barra i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-accent);
    border-radius: 99px;
    transition: width 0.2s linear;
  }
  .pista-barra::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 2.6rem;
    border-radius: 99px;
    background: linear-gradient(90deg, transparent, var(--color-accent));
    animation: viaja 2.4s var(--ease-f) infinite;
  }
  .pista-barra.movida::after {
    display: none;
  }
  @keyframes viaja {
    0% {
      transform: translateX(-2.6rem);
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
    100% {
      transform: translateX(14rem);
      opacity: 0;
    }
  }
  /* El verbo del gesto lo pone el CSS: con dedo se desliza, con mouse se
     arrastra. Decirle "arrastra" a quien trae un celular es pedirle algo que
     no va a hacer. */
  .pista-etiqueta .gesto::after {
    content: " (DESLIZA)";
  }
  @media (pointer: fine) {
    .pista-etiqueta .gesto::after {
      content: " (ARRASTRA)";
    }
  }
  .pista-cuenta {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
  }
  .pista-guia .punta {
    display: grid;
    place-items: center;
    color: var(--color-ink-dim);
  }
  .pista-guia .punta svg {
    width: 13px;
    height: 13px;
  }
  .pista-guia.movida .punta {
    opacity: 0.35;
  }
  @media (prefers-reduced-motion: reduce) {
    .pista-barra::after {
      animation: none;
      opacity: 0.6;
    }
  }

  /* La orilla derecha se desvanece: dice "hay más" sin dibujar nada. */
  .galeria-carril {
    position: relative;
    margin-top: 0.8rem;
  }
  .galeria-carril::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 2rem;
    right: 0;
    width: 5rem;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--color-bg));
    transition: opacity 0.3s;
  }
  .galeria-carril.al-final::after {
    opacity: 0;
  }

  .pista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(19rem, 21rem);
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Sin esto el snap alinea la primera tarjeta con la orilla del contenedor
       y se come el padding: las tarjetas arrancaban 24px a la izquierda del
       margen del texto. */
    scroll-padding-inline-start: 1.5rem;
    padding: 0.6rem 1.5rem 2rem;
    margin-inline: calc(50% - var(--container-default) / 2);
    scrollbar-width: none;
    cursor: grab;
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 76rem) {
    .pista {
      margin-inline: 0;
    }
  }
  .pista.arrastrando {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .pista:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .puerta {
    position: relative;
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.7rem 1.5rem 1.5rem;
    text-decoration: none;
    color: inherit;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    transition:
      transform 0.3s var(--ease-f),
      box-shadow 0.3s var(--ease-f),
      border-color 0.3s;
  }
  .puerta:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 50px -30px rgb(20 22 26 / 0.55);
    border-color: color-mix(in oklab, var(--color-line) 55%, var(--color-ink-dim));
  }
  .puerta .num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }
  .puerta h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.1;
    letter-spacing: -0.005em;
    margin: 0;
  }
  .puerta p {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .puerta .go {
    display: inline-block;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-accent);
    transition: transform 0.25s var(--ease-f);
    position: relative;
    z-index: 1;
  }
  .puerta:hover .go {
    transform: translateX(6px);
  }
  /* Marca de agua en tinta al 7%, nunca en verde: el verde marca acción y
     aquí sería decoración. Recortada por la tarjeta para que lea como fondo. */
  .puerta .ilustra {
    position: absolute;
    right: -1.4rem;
    bottom: -1.4rem;
    width: 8rem;
    height: 8rem;
    pointer-events: none;
    opacity: 0;
    color: var(--color-ink);
    transform: translateY(0.8rem) rotate(-6deg);
    transition:
      opacity 0.35s ease,
      transform 0.45s var(--ease-f);
  }
  .puerta .ilustra :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .puerta:hover .ilustra {
    opacity: 0.07;
    transform: translateY(0) rotate(-6deg);
  }
  @media (hover: none) {
    .puerta .ilustra {
      display: none;
    }
  }

  /* Cita */
  .cita {
    text-align: center;
    padding: 5rem 0;
  }
  .cita blockquote .hl {
    --hl-abajo: 0.22em;
    --hl-alto: 0.5em;
  }
  .cita blockquote {
    font-family: var(--font-serif-detail);
    font-style: italic;
    font-size: clamp(1.8rem, 4.2vw, 3rem);
    line-height: 1.16;
    max-width: 22ch;
    margin: 1.2rem auto 0;
    color: var(--color-ink);
  }

  /* Lead magnet */
  .guia {
    background: var(--color-line-strong);
  }
  .guia-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 760px) {
    .guia-inner {
      grid-template-columns: 1fr;
    }
  }
  .guia .guia-folio {
    color: #8da2c0;
  }
  .guia .guia-folio b {
    color: var(--color-terminal-ok);
  }
  .guia .guia-titulo {
    color: #ffffff;
    margin: 0.8rem 0;
  }
  .guia-texto {
    color: #aebbd1;
    max-width: 46ch;
    margin: 0;
  }
  .guia-form {
    align-self: center;
  }

  /* La tira de capas: el detalle, debajo del correo y no encima. Que se puedan
     contar es la mitad del valor percibido de un imán gratuito, y numeradas en
     mono se cuentan de un vistazo. */
  .capas-tira {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    margin: 2.6rem 0 0;
    padding: 1.6rem 0 0;
    position: relative;
  }
  /* La raya de arriba es un pseudo-elemento y no un border para poder
     dibujarla con scaleX. Un border no se anima sin tocar el layout. */
  .capas-tira::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: #2a3648;
    transform-origin: left;
  }
  .capas-tira li {
    padding: 0 1.2rem 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: #9fb0c9;
  }
  .capas-tira b {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-terminal-ok);
  }
  /* En celular cinco columnas no caben, y apiladas hacen una torre de cinco
     renglones sueltos. Dos columnas: se siguen contando y ocupan la mitad. */
  @media (max-width: 760px) {
    .capas-tira {
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem 1.4rem;
      margin-top: 2.2rem;
    }
    .capas-tira li {
      padding-right: 0;
    }
    /* La quinta queda sola en su renglón: que ocupe el ancho completo en vez
       de dejar un hueco a la derecha. */
    .capas-tira li:last-child {
      grid-column: 1 / -1;
    }
  }

  /* La raya se traza y las capas caen sobre ella, en orden. Es entrada de
     scroll, no un flujo animado: por eso es corta (todo dentro en 0.9s) y
     cuelga del data-reveal que ya existe. */
  .is-visible.capas-tira::before {
    animation: traza-tira 0.55s ease-out backwards;
  }
  .is-visible.capas-tira li {
    animation: cae-capa 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  .is-visible.capas-tira li:nth-child(1) { animation-delay: 0.18s; }
  .is-visible.capas-tira li:nth-child(2) { animation-delay: 0.3s; }
  .is-visible.capas-tira li:nth-child(3) { animation-delay: 0.42s; }
  .is-visible.capas-tira li:nth-child(4) { animation-delay: 0.54s; }
  .is-visible.capas-tira li:nth-child(5) { animation-delay: 0.66s; }
  @keyframes traza-tira {
    from { transform: scaleX(0); }
  }
  @keyframes cae-capa {
    from { opacity: 0; transform: translate3d(0, 0.6rem, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-visible.capas-tira::before,
    .is-visible.capas-tira li {
      animation: none;
    }
  }

  .cierre {
    padding-bottom: 5rem;
  }

  /* Eyebrow del hero: ancla de categoría, no cápsula de plantilla.
     Capitular normal, gris medio, sin fondo ni tracking abierto, y con aire
     generoso antes del H1: ese espacio es la mitad de por qué no se ve a
     plantilla. El icono va gris, nunca en el verde de acción. */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.92rem;
    font-weight: 400;
    color: var(--color-ink-dim);
  }
  .eyebrow svg {
    flex: none;
    color: var(--color-ink-dim);
  }
  .hero-micro {
    margin: 1.1rem 0 0;
    max-width: 46ch;
    font-size: 0.88rem;
    color: var(--color-ink-dim);
  }

  /* El marcador del titular no cuelga del observador: está sobre el pliegue y
     el H1 es el candidato a LCP. Se pinta solo al cargar, cuando ya
     terminaron de subir los cuatro renglones. */
  .portada-titulo .hl {
    transition: none;
    animation: hl-pinta 0.9s var(--ease-f) 1.15s backwards;
  }
  @keyframes hl-pinta {
    from {
      background-size: 0 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portada-titulo .hl {
      animation: none;
    }
  }

  /* La vuelta ocupa una pantalla completa y su contenido va centrado a lo
     alto. Es la única sección de la home con esa altura, y se la gana: es
     donde se voltea la objeción y donde aparece la cara de quien lo dice.
     svh y no vh, para que en móvil la barra del navegador no la desborde. */
  .vuelta {
    min-height: 100svh;
    display: grid;
    /* stretch y no center: la retícula tiene que ocupar todo el alto de la
       sección para que la figura pueda bajar hasta el canto. Centrada, solo
       llegaba al fondo de la columna de texto y quedaban 102px de aire
       debajo. El centrado vertical del texto se resuelve dentro. */
    align-items: stretch;
    /* La banda vuelve, y no por decoración: es lo que le da piso al retrato.
       Sin un borde abajo, el recorte del cuerpo no aterriza en nada y la
       figura flota. Con la banda, el canto inferior ES el suelo. */
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    /* El canto de abajo es el piso donde descansa el recorte del cuerpo, así
       que no puede ser un filete cualquiera: la banda (#F1F4F9) y el fondo de
       página (#FAFBFD) se diferencian en nueve puntos y eso no se lee. Va el
       filete fuerte, el mismo de la cuenta T y de la tira de capas. */
    border-bottom: 2px solid var(--color-line-strong);
  }
  /* El retrato deja de ser marca de agua y pasa a ser columna. Como fondo
     tenía dos problemas que no se arreglan con opacidad: en el hueco que
     dejaba el texto centrado (272px en 1280) no cabe una figura entera, así
     que había que recortarla contra el borde. Con su propia columna cabe
     completo y a opacidad plena. */
  .vuelta-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
    height: 100%;
  }
  .vuelta-retrato {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    /* Pegado al texto y no al borde de la ventana: así no se ve arrinconado. */
    margin-right: auto;
    /* Al fondo de la celda, y el margen negativo cancela el padding de la
       sección para que el cuerpo toque el canto de la banda. El texto sigue
       centrado a lo alto: solo la figura baja. */
    align-self: end;
    margin-bottom: -4.2rem;
  }
  @media (max-width: 900px) {
    .vuelta {
      min-height: 0;
    }
    .vuelta-grid {
      grid-template-columns: 1fr;
    }
    /* En una columna el retrato quedaría colgando al final del argumento sin
       hacer nada por él. La lectura manda. */
    .vuelta-retrato {
      display: none;
    }
  }

  /*
   * La objeción, en la voz de quien la dice: serif en cursiva y a tamaño de
   * titular, como en el mockup de F. A 1.45rem cabía en un renglón pero se
   * perdía entre el cuerpo, y esta frase es la que abre la sección: tiene que
   * pesar tanto como la respuesta que le sigue. Que se parta en dos o tres
   * renglones aquí no le quita nada; en la versión chica sí, porque entonces
   * competía con el párrafo.
   */
  .vuelta blockquote {
    margin: 0 0 2rem;
    padding: 0;
    font-family: var(--font-serif-detail);
    font-style: italic;
    font-size: clamp(1.5rem, 3.6vw, 2.6rem);
    line-height: 1.16;
    letter-spacing: -0.01em;
    max-width: 20ch;
    text-wrap: pretty;
  }
  /* El giro y la objeción van casi al mismo tamaño, y ahí está el gesto: dos
     frases del mismo peso, una en cursiva y gris (la voz ajena) y otra en
     redonda y tinta plena (la respuesta). Se leen como un par que se
     contesta. */
  /* La objeción entra en tinta plena y se apaga; el giro llega después, en la
     display. Es el gesto de la sección: una voz baja el volumen y la otra lo
     sube. No se tacha la cita: una raya sobre tres renglones se rompe al
     saltar de línea y además grita. */
  /*
   * El apagado va SOLO por color y no por opacidad. Con opacity 0.62 el texto
   * caía a 2.38:1 contra la banda, que no pasa ni el mínimo de texto grande
   * (3:1). En ink-dim pleno da 4.74:1 y pasa AA de texto normal, y el gesto de
   * "esta voz baja el volumen" se lee igual porque el salto es de tinta plena
   * a gris.
   */
  .vuelta blockquote {
    color: var(--color-ink);
    transition: color 0.55s var(--ease-f) 0.45s;
  }
  .vuelta [data-reveal].is-visible blockquote {
    color: var(--color-ink-dim);
  }
  .vuelta-giro {
    margin: 0 0 1.4rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  /* Solo se esconde cuando hay JS, para que sin JavaScript la frase esté ahí. */
  html.js-reveal .vuelta-giro {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 0.5s var(--ease-f) 0.7s,
      translate 0.5s var(--ease-f) 0.7s;
  }
  html.js-reveal .vuelta [data-reveal].is-visible .vuelta-giro {
    opacity: 1;
    translate: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .vuelta blockquote {
      color: var(--color-ink-dim);
      transition: none;
    }
    html.js-reveal .vuelta-giro {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
  .vuelta-texto {
    margin: 0 0 1.1rem;
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  /* El remate cierra la vuelta y entrega a la cuenta 01, que responde quién lo
     está diciendo. Cae solo y al mismo peso que el giro que abrió la sección:
     abre en negritas, explica en medio, cierra en negritas. El aire de arriba
     es la pausa antes de la frase, y hace tanto por el golpe como el tamaño. */
  .vuelta-remate {
    margin: 2.4rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.14;
    color: var(--color-ink);
  }
  /* El marcador va sobre el compromiso, no sobre la frase entera: el verde
     marca acción, y la acción es "me encargo yo". Sube a 0.62em, el mismo alto
     que en .cita, porque el default está calibrado para texto corrido y a este
     tamaño se quedaría bajo las letras. */
  .vuelta-remate .hl {
    --hl-abajo: 0.22em;
    --hl-alto: 0.5em;
  }

  /* Dos bandos dibujado como cuenta T: es el isotipo de la marca hecho
     sección. El cargo a la izquierda en tinta, el abono a la derecha con la
     letra en verde, y la raya vertical que los separa. La lectura es la
     tesis: la IA no es un total al pie, es la contrapartida que completa el
     asiento.
 */
  .bandos-entrada {
    margin: 0 0 1.8rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.14;
    color: var(--color-ink);
    max-width: 20ch;
  }
  .bandos-par {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 2px solid var(--color-line-strong);
    padding-top: 1.4rem;
  }
  /* El eje de la cuenta T. */
  .bandos-par::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--color-line-strong);
    transform-origin: top;
  }
  .bando {
    padding: 0 1.6rem;
  }
  .bando p:last-child {
    margin: 0.7rem 0 0;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }
  .bando-b .folio :global(b) {
    color: var(--color-accent);
  }
  @media (max-width: 760px) {
    /* En vertical la raya del medio no separa nada: se convierte en el filete
       lateral de cada bando. */
    .bandos-par {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .bandos-par::before {
      display: none;
    }
    .bando {
      padding: 0 0 0 1.2rem;
      border-left: 2px solid var(--color-line);

---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LeadForm from "../components/LeadForm.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Terminal from "../components/Terminal.astro";
import VideoFacade from "../components/VideoFacade.astro";
import { Icon } from "astro-icon/components";
import { FAQ_HOME } from "../lib/faqs";
import { faqPage, graph, person, testimonioVideo, webSite } from "../lib/schema";
import { CTA_DIAGNOSTICO, EBOOK, NAV_HOME, SITE } from "../lib/site";
import { TESTIMONIOS } from "../lib/testimonios";

const jsonLd = graph(
  person(),
  webSite(),
  faqPage(FAQ_HOME, `${SITE.url}/`),
  ...TESTIMONIOS.map(testimonioVideo),
);

const asientos = [
  {
    num: "01",
    icono: "ph:chalkboard-teacher-light",
    titulo: "Capacitación en IA",
    texto:
      "Ocho horas en vivo y en grupo chico, para que te dé tiempo de atorarte y preguntar. Sales con tu primer proceso automatizado funcionando, no con apuntes. Es la misma forma de trabajar con la que un solo diagnóstico destapó más de $11 millones en saldos a favor que llevaban años ahí.",
    href: "/capacitacion",
    cta: "calendario →",
  },
  {
    num: "02",
    icono: "ph:magic-wand-light",
    titulo: "¿Prefieres que yo lo haga?",
    texto:
      "Me traes el proceso que odias y te lo quito. El concentrado mensual de un cliente tomaba siete horas de captura. Hoy corre solo mientras desayunas.",
    href: "/soluciones",
    cta: "platícame →",
  },
  {
    num: "03",
    icono: "ph:plugs-connected-light",
    titulo: "Herramientas que ya funcionan",
    texto:
      "TodoConta: descarga masiva de CFDI, constancias y opinión 32-D en un clic. Más la conexión con Claude para trabajar tus XML por un canal controlado, sin pegarlos en un chat público.",
    href: "/herramientas",
    cta: "conoce →",
  },
  {
    num: "04",
    icono: "ph:book-open-light",
    titulo: `Ebook: ${EBOOK.titulo}`,
    /* El objetivo del libro no se enuncia como conocimiento ("entender la
       IA") sino como temporada: abril es el único dolor del contador que
       tiene fecha en el calendario, y por eso es el que mueve. */
    texto: `Diecisiete capítulos y tres apéndices, sin código y sin palabras raras. El objetivo no es que trabajes más: es que llegues a abril sin contratar auxiliares extra, sin pelearte con el portal del SAT a las 11 de la noche y sin dejar la vida en el despacho durante la anual. Si después de leerlo sigues sin entender de qué va esto, te devuelvo tus ${EBOOK.precio.replace("$", "$").replace(" MXN", "")}.`,
    href: EBOOK.url ?? "/contacto",
    cta: "consíguelo →",
  },
  {
    num: "05",
    icono: "ph:broadcast-light",
    titulo: "Jueves de ContadorIA",
    texto:
      "Cada jueves a las 11:00 del centro. Un problema real de un despacho real, resuelto en pantalla, sin cortes y sin que me salga a la primera. Gratis.",
    href: "/jueves",
    cta: "suscríbete →",
  },
  {
    num: "06",
    icono: "ph:users-three-light",
    titulo: "Club de Automatización Fiscal",
    texto:
      "Membresía anual con lugares contados. Software, un bootcamp de implementación cada mes, y alguien que te contesta cuando te atoras a las 11 de la noche de un día 16. No entra cualquiera y no es barato.",
    href: "/club",
    cta: "aplica →",
  },
];

/**
 * La mañana que cuenta la escena fija. Vivía dentro del <Pila> del hero; se
 * subió aquí porque ahora la recorre el scroll y el marcado la itera.
 * `quien` decide el color de la marca: verde cuando lo cerró la máquina,
 * tinta cuando lo cerraste tú. Ese contraste es el argumento del bloque.
 */
const mañana = [
  { titulo: "3,412 XML descargados", pie: "del portal del SAT, sin abrirlo", quien: "ia", dato: "31 s" },
  { titulo: "Validados contra 69 y 69-B", pie: "los 3,412, uno por uno", quien: "ia", dato: "0 riesgos" },
  { titulo: "Concentrado armado", pie: "el mismo de siempre, ya cuadrado", quien: "ia", dato: "4 hojas" },
  { titulo: "14 diferencias resueltas", pie: "esas no las decide la máquina", quien: "tu", dato: "tu criterio" },
];

const lineasTerminal = [
  { tipo: "user" as const, texto: "concilia los CFDI de marzo contra el estado de cuenta" },
  { tipo: "dim" as const, texto: "→ mcp: todoconta · leyendo 3,412 XML…" },
  { tipo: "ok" as const, texto: "✓ 3,398 conciliados · 14 diferencias detectadas" },
  { tipo: "ok" as const, texto: "✓ reporte listo en 31 segundos" },
  { tipo: "dim" as const, texto: "# la máquina hizo las 3,398 fáciles. las 14 difíciles son tuyas." },
];
---

<BaseLayout jsonLd={jsonLd} nav={NAV_HOME} cta={CTA_DIAGNOSTICO}>
  <main>
    <!--
      La portada de F: solo tipografía y aire. La pila de tarjetas que vivía
      aquí no se perdió, se desdobló en la escena de abajo, donde el lector la
      recorre en vez de mirarla quieta.
    -->
    <section class="portada">
      <div class="container-default" id="portada">
        <p class="kicker"><span aria-hidden="true"></span>IA para contadores de carrera</p>
        <h1 class="portada-titulo">
          <span class="reng" style="--reng-delay: 0.12s"><span>La IA cierra</span></span>
          <span class="reng" style="--reng-delay: 0.24s"><span>las fáciles.</span></span>
          <span class="reng" style="--reng-delay: 0.36s"><span><em>Las difíciles</em></span></span>
          <span class="reng" style="--reng-delay: 0.48s"><span>las cobras <b class="hl">tú</b>.</span></span>
        </h1>
        <div class="portada-pie">
          <p class="hero-sub">
            Descargar, validar y capturar ya se resuelve solo. Lo que no se
            resuelve solo es saber cuándo un número miente, y eso se paga con
            años. Esa es la parte que se cobra.
          </p>
          <div>
            <div class="hero-actions">
              {/* El secundario es la salida sin compromiso, y por eso baja al
                  menú en vez de mandar al live: quien todavía no quiere hablar
                  necesita ver el rango completo, no una sola puerta. La cifra
                  sale del arreglo para que el copy no pueda quedar mintiendo si
                  mañana entra o sale un asiento. */}
              <a class="btn btn-primary" href="#contacto">Platiquemos de tu caso</a>
              <a class="btn btn-ghost" href="#ofertas">Las {asientos.length} formas de empezar</a>
            </div>
            <p class="hero-micro">
              Sin costo. Me cuentas en qué se te va la vida y yo te digo si tengo cómo resolverlo.
            </p>
          </div>
        </div>
      </div>
      <span class="baja" aria-hidden="true"><i></i>Baja</span>
    </section>

    <!--
      La escena fija: la sección se queda pegada y el scroll enciende los
      renglones uno por uno. El lector no ve una animación, la ejecuta. El
      orden importa (tres los cierra la máquina, el cuarto no), y por eso
      aquí sí se justifica fijar: es una narración con remate, no un menú.
    -->
    <section class="escena" id="escena">
      <div class="escena-fija">
        <div class="container-default escena-grid">
          <div class="escena-texto">
            <p class="folio">UNA MAÑANA <b>CUALQUIERA</b></p>
            <h2 class="escena-titulo">Lo que pasó antes de tu primer café</h2>
            <p class="escena-apunte">
              Tres renglones los cerró la máquina. El cuarto no, y por eso el
              cuarto es el que se cobra.
            </p>
            <p class="escena-cuenta">ASIENTO <b id="cuenta-escena">01</b> DE 04</p>
            <div class="escena-prueba">
              <span class="caras">
                <img src="/assets/contadora-1.webp" alt="" aria-hidden="true" width="34" height="34" loading="lazy" decoding="async" />
                <img src="/assets/contador-2.webp" alt="" aria-hidden="true" width="34" height="34" loading="lazy" decoding="async" />
                <img src="/assets/contadora-3.webp" alt="" aria-hidden="true" width="34" height="34" loading="lazy" decoding="async" />
                <b>+45</b>
              </span>
              <span class="folio">Contadores que ya capacité.</span>
            </div>
          </div>
          <ol class="renglones" id="renglones">
            {mañana.map((t) => (
              <li class:list={["renglon", t.quien]}>
                <span class="marca">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.2 11.8 13 4.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span>
                  <h3>{t.titulo}</h3>
                  <p>{t.pie}</p>
                </span>
                <span class="dato">{t.dato}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!--
      El puente entre el titular y las secciones. Antes esto era la nota al pie
      completa, con la historia de la contadora de 46 años. La historia larga se
      fue, pero sin ella el titular se queda como afirmación sin respaldo: aquí
      queda la vuelta que la cerraba, que es la tesis del proyecto en tres
      frases. Termina en "de eso me encargo yo" y en seguida entra "quién te
      está hablando", que es exactamente la pregunta que deja abierta.
    -->
    <section class="vuelta">
      <div class="container-default vuelta-grid">
        <div data-reveal>
          <blockquote>
            "Esto de la IA es para los más jóvenes, ya nacieron con el chip."
          </blockquote>

          <p class="vuelta-giro">De hecho, es al revés.</p>
          <p class="vuelta-texto">
            La IA es la herramienta más fácil de usar que se ha inventado. Se le
            habla en español y no hay que cursar una carrera, así que ahí la
            barrera es pareja para todos.
          </p>
          <p class="vuelta-texto">
            Lo que no es parejo es lo demás: nadie sale de la facultad sabiendo
            lidiar con la presión de que el cliente te mande todo a última hora,
            ni sabiendo leerle la cara al empresario que esconde esos otros
            ingresos.
          </p>
          <p class="vuelta-texto">
            A ti la parte fácil te llega encima de la parte difícil, que ya
            llevas años pagando. Quien debería estar preocupado no eres tú. Lo
            que te falta es método, no juventud.
          </p>
          <p class="vuelta-remate">Y de eso <span class="hl">me encargo yo</span>.</p>
        </div>
        {/* Decorativo: aria-hidden y alt vacío porque no dice nada que el texto
            no diga ya. Es la cara de quien está hablando, no información. */}
        <img
          class="vuelta-retrato"
          src="/assets/israel-cruzado.webp"
          alt=""
          aria-hidden="true"
          width="720"
          height="961"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section id="quien">
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">CUENTA <b>01</b> · QUIÉN TE ESTÁ HABLANDO</h2></div>
        <div class="bio-grid">
          <div class="bio" data-reveal>
            <p class="lede">Soy contador público. Y desarrollador de software.</p>
            <p>
              Empecé capturando pólizas y peleándome con el portal del SAT, igual que
              tú. Catorce años de fiscal. Cierres, revisiones, clientes que te mandan
              todo un día antes del vencimiento.
            </p>
            <p>
              En algún punto me dio curiosidad el otro lado y me puse a estudiar
              programación. Terminé trabajando como desarrollador en una startup. Hoy
              estoy de regreso en el despacho, automatizando todo lo que se repite.
            </p>
            <p>
              Y aquí está la parte que importa para ti: <strong>hoy no escribo
              código. Dirijo a la IA para que lo escriba, y sé leerlo para saber
              si está bien.</strong>
            </p>
            <p>
              Esa es la habilidad que te quiero pasar. No la de programar. La de saber
              nombrar el problema. <span class="hl">Tu experiencia contable</span> más esa habilidad no la
              alcanza ningún recién egresado, por mucho chip que traiga.
            </p>
            <div class="chips">
              <span class="chip"><b>14</b> años de fiscal</span>
              <span class="chip">TodoConta · SaaS <b>2026</b></span>
              <span class="chip">MCP <b>SAT</b></span>
              <span class="chip">Live semanal · <b>jueves 11:00</b></span>
            </div>
            <p class="mas"><a href="/sobre-mi">Toda la historia →</a></p>
          </div>
          {/*
            La terminal deja de flotar al lado del texto y se vuelve figura de
            revista: encajada, con pie. En una página de papel una pantalla no
            flota, va con su explicación debajo, y eso de paso justifica que
            el único bloque oscuro no rompa la hoja.
          */}
          <figure class="figura" data-reveal style="--reveal-delay: .12s">
            <Terminal lineas={lineasTerminal} />
            {/*
              Este pie hace un trabajo concreto: desarmar la objeción número
              uno del avatar A, que es "la IA se inventa cosas". Por eso nombra
              a ChatGPT en vez de hablar de "la IA" en abstracto: la mala
              experiencia que el lector tuvo tiene nombre, y negarla en
              genérico no la desactiva.
            */}
            <figcaption class="pie-figura">
              <b>FIG. 1</b> · Así se pide. No es ChatGPT inventando datos ni
              sacándose respuestas de la manga para salir del paso. Es un canal
              controlado conectado a tus XML donde la máquina calcula, procesa el
              volumen y tú firmas con tu criterio contable.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!--
      La prueba va después de "quién te está hablando" y antes del menú: primero
      quién habla, luego que a un colega ya le funcionó, y hasta entonces qué se
      puede comprar. Cada testimonio es un artículo completo (la objeción, la
      cita, lo que cambió, la firma) y sale de lib/testimonios.ts: para sumar el
      siguiente se agrega ahí y se sube su carátula, la página no se toca. Con
      varios se apilan y el video alterna de lado.

      El nombre, el despacho y la ciudad van completos y con enlace a su sitio.
      Es lo que separa un testimonio de una cita inventada, y de paso le manda
      clientes de su zona al colega que dio la cara.
    -->
    <section id="testimonios">
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">CUENTA <b>02</b> · QUIÉN YA DIO EL PASO</h2></div>
        <p class="testimonios-lede" data-reveal>
          No me creas a mí. Estos son colegas que tomaron la capacitación, con
          nombre, despacho y ciudad.
        </p>
        {
          TESTIMONIOS.map((t) => (
            <article class="testimonio" id={`testimonio-${t.slug}`}>
              <div class="testimonio-video" data-reveal>
                <VideoFacade
                  videoId={t.videoId}
                  titulo={t.titulo}
                  poster={t.poster}
                  aria={`Reproducir el testimonio de ${t.nombre}: ${t.titulo}`}
                  cinta={`${t.nombre.split(" ")[0]} · ${t.duracionTexto}`}
                />
              </div>
              <div class="testimonio-texto" data-reveal style="--reveal-delay: .12s">
                <p class="testimonio-antes">"{t.antes}"</p>
                <blockquote class="testimonio-cita">{t.cita}</blockquote>
                <p class="folio testimonio-folio">LO QUE <b>CAMBIÓ</b> EN SU DESPACHO</p>
                <ol class="testimonio-logros">
                  {t.logros.map((logro, n) => (
                    <li>
                      <span class="testimonio-num">{String(n + 1).padStart(2, "0")}</span>
                      <span>{logro}</span>
                    </li>
                  ))}
                </ol>
                <p class="testimonio-remate">"{t.remate}"</p>
                <footer class="testimonio-firma">
                  <p class="testimonio-nombre">{t.nombre}</p>
                  <p class="folio testimonio-despacho">{t.despacho} · {t.ciudad}</p>
                  <p class="testimonio-perfil">
                    {t.perfil} Si por allá buscas un contador que ya trabaja con IA, <a href={t.sitio} rel="noopener">aquí está su despacho →</a>
                  </p>
                  {t.whatsapp && (
                    <p class="testimonio-contacto">
                      <a href={`https://wa.me/${t.whatsapp}`} rel="noopener">
                        <Icon name="ph:whatsapp-logo-light" aria-hidden="true" />
                        WhatsApp: +{t.whatsapp.slice(0, 2)} {t.whatsapp.slice(2, 5)} {t.whatsapp.slice(5, 8)} {t.whatsapp.slice(8)}
                      </a>
                    </p>
                  )}
                </footer>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!--
      Las seis puertas se recorren de lado y NO se fijan como la escena de
      arriba. La diferencia importa: la escena es una narración con orden y
      remate, y esto es un menú. Fijarlo obligaría a pasar por las seis, que
      es justo lo contrario de lo que dice el titular de la sección.
    -->
    <section id="ofertas">
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">CUENTA <b>03</b> · QUÉ ENCUENTRAS AQUÍ</h2></div>
        <p class="galeria-titulo" data-reveal>
          Seis puertas. <em>Ninguna te obliga a la siguiente.</em>
        </p>
        {/*
          "Elige tu camino" y no "arrastra de lado": lo primero dice qué ganas
          y lo segundo solo describe el gesto. El verbo del gesto cambia según
          con qué se navegue (se desliza con el dedo, se arrastra con el
          mouse), así que lo pone el CSS y no el marcado.

          El contador de posición existe porque en móvil solo se ve una
          tarjeta: sin él, las últimas del carrusel no es que estén escondidas,
          es que el lector no sabe que existen. Con "01 / 06" sabe cuántas
          faltan y que la última no es la que tiene enfrente.
        */}
        <div class="pista-guia" id="guia-pista" data-reveal>
          <span class="folio pista-etiqueta">ELIGE TU CAMINO <span class="gesto" aria-hidden="true"></span></span>
          <span class="pista-barra" id="barra-caja"><i id="barra-pista"></i></span>
          <span class="folio pista-cuenta" id="pista-cuenta" aria-hidden="true">01 / {String(asientos.length).padStart(2, "0")}</span>
          <span class="punta" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h9m0 0L8.4 4.4M12 8l-3.6 3.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </div>
      <div class="galeria-carril" id="carril">
        {/* Región desplazable y enfocable: el teclado tiene que poder
            recorrerla, no solo el mouse. */}
        <div class="pista" id="pista" tabindex="0" role="region" aria-label={`Las ${asientos.length} formas de empezar. Se recorre de lado.`}>
          {asientos.map((a) => (
            <a class="puerta" href={a.href}>
              <span class="num">{a.num}</span>
              <h3>{a.titulo}</h3>
              <p>{a.texto}</p>
              <span class="go">{a.cta}</span>
              {/* Marca de agua: aria-hidden porque no aporta información que
                  el título no dé ya, y pointer-events none para que nunca se
                  interponga al clic. */}
              <span class="ilustra" aria-hidden="true"><Icon name={a.icono} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cita">
      <div class="container-default" data-reveal>
        <span class="folio">ASIENTO DE CIERRE</span>
        <blockquote>
          Nadie contrata veinte años de criterio en un recién egresado.<br />
          Y lo que no tiene sustituto, <span class="hl">no se regatea</span>.
        </blockquote>
      </div>
    </section>

    <!--
      El campo de correo va arriba, al lado de la promesa, y el detalle de las
      cinco capas baja a una tira. Antes el correo quedaba al final de una lista
      de cinco viñetas: quien ya había decidido tenía que leerlas todas para
      encontrar dónde dejarlo.
    -->
    <section class="guia">
      <div class="container-default guia-inner">
        <div>
          <p class="folio guia-folio">DESCARGA <b>GRATUITA</b></p>
          <h2 class="guia-titulo">5 prompts para auditar tus XMLs con Claude</h2>
          <p class="guia-texto">
            No salieron de un blog gringo. Salieron del sistema de auditoría
            preventiva que corre en mi despacho. Los copias, los pegas y los
            usas hoy mismo.
          </p>
        </div>
        <div class="guia-form">
          {/* Lo del boletín se dice AQUÍ y no en un párrafo aparte: el aviso de
              a qué te estás dando de alta tiene que estar donde se da el
              correo, no tres párrafos antes. */}
          <NewsletterForm
            boton="Mándame los prompts"
            nota="Te los mando al correo, junto con una idea de IA fiscal cada semana. Te das de baja con un clic."
          />
        </div>
      </div>
      <div class="container-default">
        <ul class="capas-tira" data-reveal>
          <li><b>01</b> Validación formal del lote (Anexo 20)</li>
          <li><b>02</b> Materialidad de operaciones</li>
          <li><b>03</b> Scoring de riesgo con semáforo, al estilo del SAT</li>
          <li><b>04</b> Blindaje de proveedores (69-B y REPSE)</li>
          <li><b>05</b> El reporte ejecutivo que sí puedes cobrar</li>
        </ul>
      </div>
    </section>

    <section id="faq">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">CUENTA <b>04</b> · PREGUNTAS DIRECTAS</h2></div>
        <FaqBlock items={FAQ_HOME} />
      </div>
    </section>

    <section class="bandos">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">LA <b>PARTIDA DOBLE</b></h2></div>
        <div class="bandos-cuerpo" data-reveal>
          <p class="bandos-entrada">Hay dos despachos con los mismos años encima.</p>
          <div class="bandos-par">
            <article class="bando bando-a">
              <p class="folio">DESPACHO <b>A</b></p>
              <p>
                Se siguen bajando los XMLs de uno en uno. Ahí saben que hay
                herramientas, pero no ha habido tiempo de ver cuáles. Cada año
                cobran lo mismo, cada año cuesta un poco más, y cada tanto se pierde
                un cliente que se fue con alguien "más moderno". No es que sepan
                menos. Es que hacen manual lo que ya se resuelve solo.
              </p>
            </article>
            <article class="bando bando-b">
              <p class="folio">DESPACHO <b>B</b></p>
              <p>
                Dedicaron unas semanas a aprender a pedirle cosas a la máquina. Ahora
                entregan en la mañana lo que antes tomaba dos días, cobran por el
                criterio y no por las horas, y sus clientes ya no saben cómo operar
                sin ellos.
              </p>
            </article>
          </div>
          <p class="bandos-remate">

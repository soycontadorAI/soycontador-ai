    background: var(--color-surface);
    padding: 2rem;
    text-align: center;
  }
  .pendiente-chip {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-dim);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.8rem;
  }
  .pendiente p {
    margin: 0;
    max-width: 40ch;
    color: var(--color-ink-dim);
    font-size: 0.9rem;
  }

  /* Los pasos, con el mismo patrón de lista numerada de /audita y /flujos. */

---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import Hojas from "../components/Hojas.astro";
import VideoFacade from "../components/VideoFacade.astro";
import { COLABORACION } from "../lib/capacitacion";
import {
  BLOQUES,
  EMPIEZA,
  ENTREGABLES,
  FAQ_EMPIEZA,
  INCLUYE,
  PARA_QUIEN,
  VIDEO_EMPIEZA,
  checkoutDe,
  edicionAbierta,
  edicionesVigentes,
} from "../lib/empieza";
import { breadcrumbs, empiezaCourse, faqPage, graph } from "../lib/schema";
import { SITE, type Enlace } from "../lib/site";
import { TESTIMONIOS } from "../lib/testimonios";

const jsonLd = graph(
  empiezaCourse(),
  faqPage(FAQ_EMPIEZA, `${SITE.url}/empieza`),
  breadcrumbs([
    { name: "Inicio", path: "/" },
    { name: "Capacitación", path: "/capacitacion" },
    { name: EMPIEZA.nombreCompleto, path: "/empieza" },
  ]),
);

/* Varias fechas: el botón apunta a la primera con lugares; las agotadas se
   quedan a la vista mientras no pasen, como prueba de que se llenaron. */
const ediciones = edicionesVigentes();
const abierta = edicionAbierta();
const urlAbierta = abierta ? checkoutDe(abierta) : null;
const fechaFolio = abierta?.fechaTexto ?? ediciones[0]?.fechaTexto ?? "Próxima fecha por anunciar";
/* Daniel es la prueba de esta página: su "analfabetos en programación" es
   exactamente el miedo de quien la lee. */
const daniel = TESTIMONIOS.find((t) => t.slug === "daniel-souza");

const NAV: readonly Enlace[] = [
  { label: "Para quién", href: "#para-quien" },
  { label: "Las dos horas", href: "#las-dos-horas" },
  { label: "Lo que necesitas", href: "#necesitas" },
  { label: "Preguntas", href: "#faq" },
];
/* El botón de cabecera sigue al hero: con lugares manda al checkout; sin
   ellos, a la ficha, que es donde se explica qué sigue. */
const CTA: Enlace = urlAbierta
  ? { label: "Apartar mi lugar", href: urlAbierta }
  : { label: "Próxima fecha", href: "#apartar" };
---

<BaseLayout
  title={`${EMPIEZA.nombreCompleto}. Taller en vivo para empezar sin saber nada`}
  description={`Taller en vivo de 2 horas, ${fechaFolio.toLowerCase()}: sales con un proyecto de Claude configurado, un prompt que cita el fundamento y tu primer lote de XML revisado. Sin conocimientos previos. ${EMPIEZA.precioTexto}.`}
  jsonLd={jsonLd}
  nav={NAV}
  cta={CTA}
>
  {/*
    Los mundos de la home (Hojas.astro, 2026-10-01): día, noche, día, noche,
    día. Elegida por Israel el 2026-10-13 entre tres variantes (ver
    docs/empieza-rediseno-2026-10.md). `data-pausa` es el ritmo de lectura:
    una hoja alta se queda fija 30% de la ventana con su final a la vista antes
    de que la siguiente la tape (en la home no se usa).
  */}
  <main data-pausa="0.3">
    <div class="mundo" data-mundo="dia">
      <section class="hero">
        <div class="container-default hero-grid">
          <div>
            <p class="folio">TALLER EN VIVO · <b>{fechaFolio.toUpperCase()}</b> · 11:00 · 2 HORAS</p>
            <h1 class="titulo-xl">{EMPIEZA.nombre}: <span class="hl">{EMPIEZA.titulo}</span></h1>
            <p class="hero-headline">Sales con tres cosas hechas, no con apuntes.</p>
            {/*
              Sin mencionar el curso grande (Israel, 2026-10-13): quien llega
              sin contexto o prefiere "el otro" y no aprovecha este, o no sabe
              de qué le hablamos. La escalera se sube DESPUÉS: al cierre del
              taller, por correo o WhatsApp.
            */}
            <p class="hero-gancho">
              ¿Ni la has abierto, o la probaste y te contestó como blog?{" "}
              <span class="tenue">En dos horas, en vivo y con tus propios casos, dejas de mirarla desde afuera.</span>
            </p>
            <div class="hero-precio">
              <p class="precio">
                <b>{EMPIEZA.precioTexto}</b>
                <span>pago único · {EMPIEZA.duracion} · cupo de {EMPIEZA.cupo}</span>
              </p>
              <div class="hero-acciones">
                {urlAbierta ? (
                  <a class="btn btn-primary" href={urlAbierta} rel="noopener">Apartar mi lugar</a>
                ) : ediciones.length ? (
                  <span class="btn btn-primary btn-espera" aria-disabled="true">Cupo lleno. La siguiente fecha, en unos días</span>
                ) : (
                  <span class="btn btn-primary btn-espera" aria-disabled="true">Próxima fecha por anunciar</span>
                )}
                <a class="btn btn-ghost" href="#las-dos-horas">Ver las dos horas</a>
              </div>
              {ediciones.length > 1 && (
                <ul class="fechas" aria-label="Fechas">
                  {ediciones.map((e) => (
                    <li class:list={{ agotada: e.agotado }}>
                      {e.fechaTexto}
                      <span class="folio">{e.agotado ? "AGOTADO" : "QUEDAN LUGARES"}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          <aside class="entregables" aria-labelledby="entregables-titulo">
            {/* El video es atemporal (sin fecha ni precio) y sirve en cada
                edición. Hasta que exista su ID de YouTube no se pinta. */}
            {VIDEO_EMPIEZA.id && (
              <div class="entregables-video">
                <VideoFacade
                  videoId={VIDEO_EMPIEZA.id}
                  titulo={VIDEO_EMPIEZA.titulo}
                  poster={VIDEO_EMPIEZA.poster}
                  cinta={VIDEO_EMPIEZA.cinta}
                />
              </div>
            )}
            <p class="folio" id="entregables-titulo">CON QUÉ <b>SALES</b></p>
            <ol>
              {ENTREGABLES.map((e, i) => (
                <li>
                  <span class="entregable-num">{String(i + 1).padStart(2, "0")}</span>
                  <span>
                    <b>{e.titulo}</b>
                    <span class="entregable-texto">{e.texto}</span>
                  </span>
                </li>
              ))}
            </ol>
          </aside>
        </div>
      </section>

      <section id="para-quien">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">PARA <b>QUIÉN</b> ES</h2></div>
          <div class="perfiles">
            {PARA_QUIEN.map((p, i) => (
              <article class="perfil" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </article>
            ))}
          </div>
          <p class="no-es" data-reveal>
            Y para quién no: si ya usas proyectos de Claude y quieres construir
            con Claude Code, este taller se te queda corto. <a href="#faq">Aquí te digo por dónde seguir.</a>
          </p>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="noche">
      <section id="las-dos-horas">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">LAS <b>DOS HORAS</b>, EN CINCO BLOQUES</h2></div>
          {/* Sin minutos (Israel, 2026-10-13): a veces se extiende o va más
              rápido y no quiere la presión del reloj. El orden sí es fijo. */}
          <p class="intro-bloques" data-reveal>
            Ritmo de taller, no de plática: cada bloque termina con algo hecho en
            tu pantalla. El orden es este; los tiempos se ajustan al grupo. Los
            datos son ficticios y te los llevas.
          </p>
          <ol class="bloques">
            {BLOQUES.map((b, i) => (
              <li class="bloque" data-reveal>
                <span class="bloque-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{b.titulo}</h3>
                  <p>{b.texto}</p>
                  <p class="bloque-sale"><span class="folio">SALES CON</span> {b.sale}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="necesitas">
        <div class="container-narrow">
          <div class="sec-head"><h2 class="folio">LO QUE <b>NECESITAS</b></h2></div>
          <div class="necesitas" data-reveal>
            {/*
              Claude Pro se RECOMIENDA, no se exige (decisión de Israel,
              2026-10-12; antes era obligatorio). El porqué (el límite del plan
              gratuito se agota a media práctica) y la salida (se cancela antes
              de que se renueve) están en el bloque y en la FAQ. El precio va
              en dólares, como lo muestra Claude, con el aproximado en pesos.
            */}
            <p>
              <b>Una suscripción a {EMPIEZA.herramienta.nombre}, que te recomiendo.</b>{" "}
              Cuesta {EMPIEZA.herramienta.costoTexto}. El plan gratuito tiene
              límites de uso, y si se te acaban a media práctica te quedas a
              medias. Si después del taller no te sirve, la cancelas antes de que
              se renueve. Apuesto a que no la cancelas: con lo que vemos en las
              dos horas, el tiempo que recuperas vale mucho más que eso. Si no la
              tienes, en el correo de confirmación te digo cómo sacarla en cinco
              minutos.
              <span class="nota-fecha">Precio en claude.com/pricing, verificado el {EMPIEZA.herramienta.verificado}.</span>
            </p>
            <p><b>Computadora, no celular.</b> Se trabaja en vivo, con archivos.</p>
            <p><b>Nada más.</b> Ni programación, ni IA, ni haber leído nada. Cero.</p>
          </div>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="dia">
      {daniel && (
        <section>
          <div class="container-narrow">
            <div class="sec-head"><h2 class="folio">ALGUIEN QUE <b>YA EMPEZÓ</b></h2></div>
            <figure class="prueba" data-reveal>
              <blockquote>"{daniel.antes}"</blockquote>
              <p class="prueba-texto">
                {daniel.nombre} lleva solo su despacho en {daniel.ciudad}. Hoy
                encuentra en minutos la diferencia entre el auxiliar de bancos y el
                estado de cuenta, que le tomaba horas. Lo cuenta en 3 minutos:{" "}
                <a href={`/#testimonio-${daniel.slug}`}>su testimonio →</a>
              </p>
            </figure>
          </div>
        </section>
      )}

      {/* Antes de apartar: primero quién es, luego cuánto cuesta. El recorte
          sin fondo reemplaza al círculo azul de la foto anterior. */}
      <section id="autor">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">QUIÉN <b>LO DA</b></h2></div>
          <div class="autor" data-reveal>
            <div class="autor-texto">
              <p>
                Soy Israel Castro, contador público con 14 años de ejercicio y
                desarrollador de software. Empecé capturando pólizas y peleándome
                con el portal del SAT, igual que tú.
              </p>
              <p>
                Cada jueves resuelvo un problema de despacho en vivo en{" "}
                <a href="/jueves">Jueves de ContadorIA</a>, y doy los módulos de
                Claude Code y de Excel en {COLABORACION?.nombre ?? "Claude para Contadores"}. Este taller
                es lo que le daría a alguien antes de cualquiera de las dos cosas.
              </p>
            </div>
            <img
              src="/assets/israel-saco-invita.webp"
              alt="Israel Castro invitando a pasar"
              width="760"
              height="1018"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="noche">
      <section id="apartar">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">CÓMO <b>APARTAR</b> TU LUGAR</h2></div>
          <article class="compra" data-reveal>
            <div class="compra-izq">
              <p class="folio">{fechaFolio.toUpperCase()} · <b>{EMPIEZA.horario.toUpperCase()}</b></p>
              <ul class="incluye">
                {INCLUYE.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="compra-der">
              <p class="precio"><b>{EMPIEZA.precioTexto}</b> <span>pago único · recomendado: {EMPIEZA.herramienta.nombre}, aparte</span></p>
              {ediciones.length > 1 ? (
                <ul class="compra-fechas">
                  {ediciones.map((e) => {
                    const url = e.agotado ? null : checkoutDe(e, "ficha");
                    return (
                      <li class:list={{ agotada: e.agotado }}>
                        <span>{e.fechaTexto}</span>
                        {url ? (
                          <a class="btn btn-primary" href={url} rel="noopener">Apartar mi lugar</a>
                        ) : (
                          <span class="folio">{e.agotado ? "AGOTADO" : "ABRE EN UNOS DÍAS"}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              ) : urlAbierta ? (
                <a class="btn btn-primary" href={urlAbierta} rel="noopener">Apartar mi lugar</a>
              ) : ediciones.length ? (
                <p class="espera-texto">Esta fecha se llenó. La siguiente se anuncia en unos días en el boletín; si quieres que te avise, <a href="/contacto">escríbeme</a>.</p>
              ) : (
                <p class="espera-texto">Esta fecha ya pasó. La siguiente se anuncia en el boletín y en <a href="/jueves">Jueves de ContadorIA</a>.</p>
              )}
              <p class="garantia folio">// {EMPIEZA.garantia.toUpperCase()}</p>
            </div>
          </article>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="dia">
      <section id="faq">
        <div class="container-narrow">
          <div class="sec-head"><h2 class="folio">PREGUNTAS <b>DIRECTAS</b></h2></div>
          <FaqBlock items={FAQ_EMPIEZA} />
        </div>
      </section>
    </div>
  </main>
  <Hojas />
</BaseLayout>

<script>
  import { medirMeta } from "../lib/medir";

  // Pixel de Meta: quien llega a la página del taller. Sin datos personales.
  medirMeta("ViewContent", { content_name: "empieza-aqui" });
</script>

<style>
  section {
    padding: 3.4rem 0;
  }
  .hero {
    padding-top: 4.5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.2rem;
    align-items: start;
  }
  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }
  .titulo-xl .hl {
    --hl-abajo: 0.22em;
  }
  .hero-headline {
    margin: 0.7rem 0 1.4rem;
    font-family: var(--font-serif-detail);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--color-ink-soft);
  }
  .hero-gancho {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.45;
    max-width: 48ch;
  }
  .tenue {
    color: var(--color-ink-dim);
  }
  .hero-precio {
    margin-top: 1.8rem;
  }
  .precio {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
  }
  .precio b {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.02em;
  }
  .precio span {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-ink-dim);
    font-size: 0.85rem;
  }
  .hero-acciones {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  /* Un botón que todavía no lleva a ningún lado se ve como botón para que el
     lugar del CTA no cambie cuando entre el enlace, pero apagado por color
     (no por opacidad: contraste) y sin cursor. */
  .btn-espera {
    background: var(--color-ink-dim);
    cursor: default;
  }
  /* Lista de fechas bajo el CTA, solo cuando hay más de una. La agotada se
     apaga por color, no por opacidad, y no se tacha: una fecha que se llenó
     es prueba, no error. */
  .fechas {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    font-weight: 500;
  }
  .fechas li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .fechas li .folio {
    color: var(--color-accent);
  }
  .fechas li.agotada {
    color: var(--color-ink-dim);
  }
  .fechas li.agotada .folio {
    color: var(--color-ink-dim);
  }

  /* Los tres entregables, en tarjeta: son el argumento entero */
  .entregables {
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: 10px 10px 0 var(--color-line);
    padding: 1.6rem 1.8rem 1.2rem;
  }
  .entregables-video {
    margin-bottom: 1.4rem;
  }
  .entregables ol {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
  }
  .entregables li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-line);
  }
  .entregable-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .entregables b {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .entregable-texto {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .perfiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  @media (max-width: 800px) {
    .perfiles {
      grid-template-columns: 1fr;
    }
  }
  .perfil {
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    padding: 1.4rem 1.6rem;
  }
  .perfil h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .perfil p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
  .no-es {
    margin: 1.8rem 0 0;
    color: var(--color-ink-soft);
    max-width: 62ch;
  }
  .no-es a {
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .intro-bloques {
    margin: 0 0 1.8rem;
    color: var(--color-ink-soft);
    max-width: 56ch;
  }
  .bloques {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .bloque {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.2rem;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  @media (max-width: 640px) {
    .bloque {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
  .bloque-num {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--color-accent);
  }
  .bloque h3 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .bloque p {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 64ch;
  }
  .bloque-sale {
    margin-top: 0.6rem !important;
    color: var(--color-ink) !important;
  }
  .bloque-sale .folio {
    margin-right: 0.4rem;
  }

  .necesitas p {
    margin: 0 0 1rem;
    color: var(--color-ink-soft);
  }
  .necesitas p:last-child {
    margin-bottom: 0;
  }
  .necesitas b {
    color: var(--color-ink);
  }
  /* El dato del proveedor lleva su fecha de verificación (AGENTS.md). */
  .nota-fecha {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-ink-dim);
  }

  .prueba {
    margin: 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--color-marker);
  }
  .prueba blockquote {
    margin: 0 0 0.8rem;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.16;
    color: var(--color-ink);
  }
  .prueba-texto {
    margin: 0;
    color: var(--color-ink-soft);
    max-width: 58ch;
  }
  .prueba-texto a {
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  /* La tarjeta ocupa el ancho y se parte en dos: lo que incluye a la izquierda
     y la decisión (precio, fecha, botón) en un panel de otra superficie. */
  .compra {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: 8px 8px 0 var(--color-line);
    overflow: hidden;
  }
  @media (max-width: 800px) {
    .compra {
      grid-template-columns: 1fr;
    }
  }
  .compra-izq {
    padding: 1.9rem 2rem;
  }
  .compra-der {
    padding: 1.9rem 2rem;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.1rem;
  }
  .compra-der .precio {
    margin: 0;
  }
  .compra-der .btn {
    justify-content: center;
  }
  .incluye {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
  }
  .incluye li {
    padding: 0.55rem 0 0.55rem 1.6rem;
    position: relative;
    color: var(--color-ink-soft);
    border-bottom: 1px solid var(--color-line);
    font-size: 0.94rem;
  }

---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import VideoFacade from "../components/VideoFacade.astro";
import { breadcrumbs, graph, juevesSeries, trailerVideo } from "../lib/schema";
import { PROGRAMA, TRAILER } from "../lib/site";

const jsonLd = graph(
  juevesSeries(),
  trailerVideo(),
  breadcrumbs([
    { name: "Inicio", path: "/" },
    { name: "Jueves de ContadorIA", path: "/jueves" },
  ]),
);
---

<BaseLayout
  title="Jueves de ContadorIA, el live semanal de IA para contadores"
  description="Cada jueves a las 11:00 (hora del centro de México) resuelvo en vivo un problema real de un despacho usando IA: CFDI, conciliaciones, papeles de trabajo y automatización, sin humo y con casos del SAT."
  jsonLd={jsonLd}
>
  <main>
    <section class="encabezado">
      <div class="container-default hero-grid">
        <div>
          <p class="folio"><span class="vivo" aria-hidden="true"></span> EN VIVO · <b>JUEVES 11:00</b> · HORA DEL CENTRO</p>
          <h1 class="titulo-xl">{PROGRAMA.nombre}</h1>
          <p class="intro-page">
            Un problema real de un despacho, resuelto con IA frente a ti. Sin
            diapositivas de relleno: pantalla compartida, casos del SAT y el paso a
            paso completo, incluyendo lo que sale mal.
          </p>
          <div class="acciones">
            <a class="btn btn-primary" href={PROGRAMA.canal} rel="noopener">Ir al canal y suscribirme</a>
            <a class="btn btn-ghost" href="#recordatorio">Recuérdamelo por correo</a>
          </div>
        </div>
        <div class="hero-video">
          <VideoFacade
            videoId={TRAILER.videoId}
            titulo={TRAILER.titulo}
            poster={TRAILER.poster}
            aria={`Reproducir el video de bienvenida: ${TRAILER.titulo}`}
            cinta={`El tráiler · ${TRAILER.duracionTexto}`}
          />
        </div>
      </div>
    </section>

    <section class="trailer">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">POR QUÉ <b>ESTE</b> Y NO OTRO CANAL DE IA</h2></div>
        <div class="guion">
          <p class="guion-lede" data-reveal>
            No solo uso la inteligencia artificial todos los días:{" "}
            <span class="hl">construyo herramientas fiscales con ella</span>.
          </p>
          <ul class="guion-pruebas">
            <li data-reveal style="--reveal-delay:.10s">
              <span class="guion-num">01</span>
              <span><b>Descarga masiva de CFDI</b> del portal del SAT</span>
            </li>
            <li data-reveal style="--reveal-delay:.20s">
              <span class="guion-num">02</span>
              <span>Un <b>agente</b> que atiende desde la palma de tu mano</span>
            </li>
            <li data-reveal style="--reveal-delay:.30s">
              <span class="guion-num">03</span>
              <span>Una <b>API</b> que ya usan otras empresas</span>
            </li>
            <li class="guion-total" data-reveal style="--reveal-delay:.42s">
              <span class="guion-num">=</span>
              <span>Productos de verdad, <b>en producción</b></span>
            </li>
          </ul>
          <p class="guion-cierre" data-reveal style="--reveal-delay:.5s">
            Cada jueves te enseño a usarla y a construir con ella sin ser
            programador. En palabras simples, de colega a colega, para que le
            ganes horas de trabajo y{" "}
            <span class="hl">dejes de tenerle miedo a la tecnología</span>.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">CÓMO <b>FUNCIONA</b></h2></div>
        <div class="grid3">
          <article class="paso" data-reveal>
            <span class="num">01</span>
            <h3>Un caso real por semana</h3>
            <p>Auditar CFDI, conciliar contra estados de cuenta, armar papeles de
               trabajo, automatizar descargas: lo que un despacho vive cada mes.</p>
          </article>
          <article class="paso" data-reveal style="--reveal-delay:.08s">
            <span class="num">02</span>
            <h3>Resuelto en vivo, con IA</h3>
            <p>Ves los prompts completos, las herramientas y el criterio detrás de
               cada decisión. Lo que funciona se explica; lo que falla, también.</p>
          </article>
          <article class="paso" data-reveal style="--reveal-delay:.16s">
            <span class="num">03</span>
            <h3>Te llevas el método</h3>
            <p>Cada emisión deja material replicable para tu propio despacho. Y si
               quieres implementarlo con acompañamiento, para eso están la
               capacitación y el Club.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="recordatorio" class="guia">
      <div class="container-default guia-inner">
        <div>
          <p class="folio guia-folio">CADA <b>SEMANA</b></p>
          <h2 class="titulo-lg guia-titulo">Que no se te pase el live</h2>
          <p class="guia-texto">
            Déjame tu correo y te aviso qué caso toca cada jueves, con el link
            directo y una idea accionable de IA fiscal por semana.
          </p>
        </div>
        <div>
          <NewsletterForm boton="Avísame cada jueves" />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 3.4rem 0;
  }
  .encabezado {
    padding-top: 4.5rem;
  }
  .vivo {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e5484d;
    margin-right: 0.4rem;
    animation: pulso 1.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .vivo {
      animation: none;
    }
  }
  @keyframes pulso {
    50% {
      opacity: 0.35;
    }
  }
  .acciones {
    margin-top: 2rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 3.5rem;
    align-items: center;
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }

  /*
   * El guion del tráiler, animado con CSS: cada prueba se "asienta" en cascada
   * al entrar en viewport (data-reveal + --reveal-delay), y las dos frases
   * ancla se subrayan con el marcador de la marca.
   */
  .guion-lede {
    margin: 0;
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .guion-pruebas {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .guion-pruebas li {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-soft);
  }
  .guion-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink-dim);
  }
  .guion-pruebas b {
    color: var(--color-ink);
    font-weight: 700;
  }
  .guion-total {
    border-bottom: none !important;
    border-top: 1.5px solid var(--color-line-strong);
    box-shadow: 0 3px 0 -1px var(--color-line-strong);
    margin-top: 0.3rem;
  }
  .guion-total .guion-num {
    color: var(--color-accent);
    font-size: 1.1rem;
  }
  .guion-total b {
    color: var(--color-accent);
  }
  .guion-cierre {
    margin: 2.2rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 860px) {
    .grid3 {
      grid-template-columns: 1fr;
    }
  }
  .paso {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.8rem;
  }
  .paso .num {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-ink-dim);
  }
  .paso h3 {
    margin: 0.7rem 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .paso p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--color-ink-soft);
  }
  .guia {
    background: var(--color-line-strong);
  }
  .guia-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 760px) {
    .guia-inner {
      grid-template-columns: 1fr;
    }
  }
  .guia .guia-folio {
    color: #8da2c0;
  }
  .guia .guia-folio b {
    color: var(--color-terminal-ok);
  }
  .guia-titulo {
    color: #ffffff;
    margin: 0.8rem 0;
  }
  .guia-texto {
    color: #aebbd1;
    max-width: 46ch;
    margin: 0;
  }
</style>

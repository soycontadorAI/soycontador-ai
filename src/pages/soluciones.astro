---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import FlujoConcentrado from "../components/FlujoConcentrado.astro";
import LeadForm from "../components/LeadForm.astro";
import { FAQ_SOLUCIONES } from "../lib/faqs";
import { breadcrumbs, faqPage, graph, solucionesService } from "../lib/schema";
import { SITE, type Enlace } from "../lib/site";
import { CASO_GASOLINERA, SOLUCIONES, VIGIA } from "../lib/soluciones";

const NAV: readonly Enlace[] = [
  { label: "Caso real", href: "#caso" },
  { label: "Qué construyo", href: "#que-construyo" },
  { label: "Vigía fiscal", href: "#vigia-fiscal" },
  { label: "Preguntas", href: "#faq" },
];
const CTA: Enlace = { label: "Cotiza tu proceso", href: "#contacto" };

const jsonLd = graph(
  solucionesService(),
  faqPage(FAQ_SOLUCIONES, `${SITE.url}/soluciones`),
  breadcrumbs([
    { name: "Inicio", path: "/" },
    { name: "Soluciones a la medida", path: "/soluciones" },
  ]),
);
---

<BaseLayout
  title="Soluciones a la medida: automatización de procesos contables"
  description="¿Prefieres que lo haga por ti? Automatizo procesos contables y fiscales de despachos y empresas en México: reportes recurrentes, conciliaciones y concentrados que hoy haces a mano, convertidos en herramientas que corren en segundos."
  jsonLd={jsonLd}
  nav={NAV}
  cta={CTA}
>
  <main>
    <section class="encabezado">
      <div class="container-default">
        <p class="folio">SOLUCIONES <b>A LA MEDIDA</b></p>
        <h1 class="titulo-xl">¿No quieres aprenderlo tú? Lo automatizo por ti</h1>
        <p class="intro-page">
          No todo el mundo quiere meterse a la IA, y no hace falta. Si tienes un
          proceso que se repite cada mes, yo construyo la herramienta que lo hace
          en segundos y tú sigues poniendo lo que la máquina no tiene: el criterio.
        </p>
      </div>
    </section>

    <section id="caso">
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">CASO <b>REAL</b> · CORTES DE GASOLINERA</h2></div>
        <div class="caso">
          <div class="caso-texto" data-reveal>
            <h2 class="titulo-lg">De 7 horas de captura al mes, a segundos</h2>
            <p class="texto">
              {CASO_GASOLINERA.contexto}. Concentrarlos a mano costaba
              {" "}{CASO_GASOLINERA.antes.toLowerCase()}, según lo que hubiera encima
              esa semana.
            </p>
            <p class="texto">
              <strong>Ese tiempo ya no existe.</strong> El reporte se corre solo,
              con el mismo formato de siempre, y las horas recuperadas se
              facturan en trabajo que sí requiere criterio.
            </p>
          </div>
          <FlujoConcentrado />
        </div>
      </div>
    </section>

    <section id="que-construyo">
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">QUÉ <b>PUEDO CONSTRUIRTE</b></h2></div>
        <div class="grid3" data-reveal>
          {SOLUCIONES.map((s, i) => (
            <article class="tarjeta">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.titulo}</h3>
              <p>{s.descripcion}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="vigia-fiscal">
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">PRODUCTO · <b>VIGÍA FISCAL</b></h2></div>
        <div class="vigia" data-reveal>
          <div class="vigia-texto">
            <h2 class="titulo-lg">{VIGIA.promesa}</h2>
            <p class="texto">
              Cuando llevas 30, 300 o 3,000 RFCs, la vigilancia deja de escalar a
              mano. El vigía consulta cada uno por su cuenta y te avisa el mismo
              día en que algo cambia, no cuando ya te habló el cliente.
            </p>
            <p class="texto">
              Las listas 69 y 69-B son públicas. La opinión y la constancia corren
              con los accesos que tu despacho ya administra de cada cliente, así
              que el vigía no pide nada que no tengas hoy.
            </p>
            <p class="texto">
              <strong>Para quién es:</strong> {VIGIA.paraQuien}
            </p>
            <p class="vigia-cta">
              <a class="btn btn-primary" href="#contacto" data-vigia-cta>Cotizarlo para mi cartera</a>
            </p>
          </div>
          <div class="vigia-panel">
            <ul class="vigia-lista">
              {VIGIA.vigila.map((v) => (
                <li>
                  <b>{v.que}</b>
                  <span>{v.detalle}</span>
                </li>
              ))}
            </ul>
            <div class="vigia-limite">
              <p class="vigia-limite-t">{VIGIA.noHace.titulo}</p>
              <p>{VIGIA.noHace.detalle}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container-default" data-reveal>
        <LeadForm
          titulo="Cuéntame qué proceso te está comiendo el tiempo"
          intro="Descríbeme el reporte o el proceso (aunque sea en una línea) y te digo si se puede automatizar, cuánto tiempo te regresa y cómo lo haríamos. El diagnóstico no cuesta."
          interesDefault="Solución a la medida"
        />
      </div>
    </section>

    <section id="faq">
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">PREGUNTAS <b>DIRECTAS</b></h2></div>
        <FaqBlock items={FAQ_SOLUCIONES} />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .caso {
    display: grid;
    gap: 2.4rem;
  }
  .caso-texto .texto {
    max-width: 68ch;
  }
  .texto {
    color: var(--color-ink-soft);
    margin: 0.9rem 0 0;
    max-width: 54ch;
  }
  .texto strong {
    color: var(--color-ink);
  }
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 860px) {
    .grid3 {
      grid-template-columns: 1fr;
    }
  }
  .tarjeta {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.8rem;
  }
  .tarjeta .num {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-ink-dim);
  }
  .tarjeta h3 {
    margin: 0.7rem 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .tarjeta p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--color-ink-soft);
  }

  .vigia {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .vigia {
      grid-template-columns: 1fr;
    }
  }
  .vigia-cta {
    margin: 1.7rem 0 0;
  }
  .vigia-panel {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    box-shadow: 6px 6px 0 var(--color-line);
    overflow: hidden;
  }
  .vigia-lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vigia-lista li {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .vigia-lista li:last-child {
    border-bottom: none;
  }
  .vigia-lista b {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .vigia-lista span {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .vigia-limite {
    padding: 1.2rem 1.5rem 1.4rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-line-strong);
  }
  .vigia-limite p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }
  .vigia-limite .vigia-limite-t {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
</style>

<script>
  /*
   * El formulario de esta página es uno solo y cierra tres intenciones. Si
   * alguien llega por el vigía, el select debe llegar ya en esa opción: si no,
   * el lead entra etiquetado como "quitarme un proceso" y se pierde el dato
   * más útil para cotizarlo (que trae cartera).
   */
  document.querySelector("[data-vigia-cta]")?.addEventListener("click", () => {
    const interes = document.querySelector<HTMLSelectElement>("#lead-interes");
    if (interes) interes.value = "Vigía fiscal";
  });
</script>

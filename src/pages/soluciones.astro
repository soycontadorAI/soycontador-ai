---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LeadForm from "../components/LeadForm.astro";
import Poliza from "../components/Poliza.astro";
import { FAQ_SOLUCIONES } from "../lib/faqs";
import { breadcrumbs, faqPage, graph, solucionesService } from "../lib/schema";
import { SITE } from "../lib/site";
import { CASO_GASOLINERA, SOLUCIONES } from "../lib/soluciones";

const jsonLd = graph(
  solucionesService(),
  faqPage(FAQ_SOLUCIONES, `${SITE.url}/soluciones`),
  breadcrumbs([
    { name: "Inicio", path: "/" },
    { name: "Soluciones a la medida", path: "/soluciones" },
  ]),
);
---

<BaseLayout
  title="Soluciones a la medida: automatización de procesos contables"
  description="¿Prefieres que lo haga por ti? Automatizo procesos contables y fiscales de despachos y empresas en México: reportes recurrentes, conciliaciones y concentrados que hoy haces a mano, convertidos en herramientas que corren en segundos."
  jsonLd={jsonLd}
>
  <main>
    <section class="encabezado">
      <div class="container-default">
        <p class="folio">SOLUCIONES <b>A LA MEDIDA</b></p>
        <h1 class="titulo-xl">¿No quieres aprenderlo tú? Lo automatizo por ti</h1>
        <p class="intro-page">
          No todo el mundo quiere meterse a la IA, y no hace falta. Si tienes un
          proceso que se repite cada mes, yo construyo la herramienta que lo hace
          en segundos y tú sigues poniendo lo que la máquina no tiene: el criterio.
        </p>
      </div>
    </section>

    <section>
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">CASO <b>REAL</b> · CORTES DE GASOLINERA</h2></div>
        <div class="caso" data-reveal>
          <div>
            <h2 class="titulo-lg">De 7 horas de captura al mes, a segundos</h2>
            <p class="texto">
              {CASO_GASOLINERA.contexto}. Concentrarlos a mano costaba
              {" "}{CASO_GASOLINERA.antes.toLowerCase()}.
            </p>
            <p class="texto">
              {CASO_GASOLINERA.detalle}
            </p>
            <p class="texto">
              <strong>Ese tiempo ya no existe.</strong> Hoy el reporte se corre
              solo, con el mismo formato de siempre, y las horas recuperadas se
              facturan en trabajo que sí requiere criterio.
            </p>
          </div>
          <Poliza
            folio="CASO GAS-01"
            titulo="ANTES / DESPUÉS"
            columnaCargo="Tiempo"
            filas={[
              { concepto: "Captura manual del concentrado", cargo: "6-7 h/mes" },
              { concepto: "Días calendario ocupados", cargo: "1-3 días" },
              { concepto: "Hojas por revisar a mano", cargo: "31 × sucursal" },
            ]}
            total={{ concepto: "Hoy, con el script en Python", cargo: "segundos" }}
            nota="// mismo formato de salida, cero captura"
          />
        </div>
      </div>
    </section>

    <section>
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">QUÉ <b>PUEDO CONSTRUIRTE</b></h2></div>
        <div class="grid3" data-reveal>
          {SOLUCIONES.map((s, i) => (
            <article class="tarjeta">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.titulo}</h3>
              <p>{s.descripcion}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="container-default" data-reveal>
        <LeadForm
          titulo="Cuéntame qué proceso te está comiendo el tiempo"
          intro="Descríbeme el reporte o el proceso (aunque sea en una línea) y te digo si se puede automatizar, cuánto tiempo te regresa y cómo lo haríamos. El diagnóstico no cuesta."
          interesDefault="Solución a la medida"
        />
      </div>
    </section>

    <section>
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">PREGUNTAS <b>DIRECTAS</b></h2></div>
        <FaqBlock items={FAQ_SOLUCIONES} />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 3.4rem 0;
  }
  .encabezado {
    padding-top: 4.5rem;
  }
  .caso {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .caso {
      grid-template-columns: 1fr;
    }
  }
  .texto {
    color: var(--color-ink-soft);
    margin: 0.9rem 0 0;
    max-width: 54ch;
  }
  .texto strong {
    color: var(--color-ink);
  }
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 860px) {
    .grid3 {
      grid-template-columns: 1fr;
    }
  }
  .tarjeta {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.8rem;
  }
  .tarjeta .num {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-ink-dim);
  }
  .tarjeta h3 {
    margin: 0.7rem 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .tarjeta p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--color-ink-soft);
  }
</style>

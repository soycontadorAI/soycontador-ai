---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import FormCapacitacion from "../components/FormCapacitacion.astro";
import FlujoExpediente from "../components/FlujoExpediente.astro";
import {
  CASO_AUDITOR,
  EMPRESARIAL,
  ORGANIZACIONES,
  TALLER,
  edicionVigente,
  fechaDeEdicion,
} from "../lib/capacitacion";
import { FAQ_CAPACITACION } from "../lib/faqs";
import { breadcrumbs, capacitacionService, faqPage, graph } from "../lib/schema";
import { SITE } from "../lib/site";

/** Null si la fecha ya pasó: nunca se anuncia una edición vencida. */
const edicion = edicionVigente();

const jsonLd = graph(
  capacitacionService(),
  faqPage(FAQ_CAPACITACION, `${SITE.url}/capacitacion`),
  breadcrumbs([
    { name: "Inicio", path: "/" },
    { name: "Capacitación", path: "/capacitacion" },
  ]),
);
---

<BaseLayout
  title="Capacitación en IA para contadores y despachos contables"
  description="Talleres de inteligencia artificial aplicada al trabajo fiscal en México: el taller de 8 horas en sesiones de 2 horas, con 30 días de acompañamiento, más capacitación para empresas y despachos y licenciamiento para organizaciones y capacitadoras."
  jsonLd={jsonLd}
>
  <main>
    <section class="encabezado">
      <div class="container-default">
        <p class="folio">CAPACITACIÓN · <b>IA PARA CONTADORES</b></p>
        <h1 class="titulo-xl">Tu equipo, trabajando con IA sobre casos reales del SAT</h1>
        <p class="intro-page">
          No es un curso de teoría: en cada sesión automatizamos procesos reales
          (CFDI, conciliaciones, papeles de trabajo) y tu equipo se lleva prompts
          y flujos funcionando. Tres formas de tomarla, según tu caso.
        </p>
      </div>
    </section>

    <section>
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">CASO <b>REAL</b> · AUDITOR CON PODERES</h2></div>
        <div class="caso">
          <div class="caso-texto" data-reveal>
            <h2 class="titulo-lg">{CASO_AUDITOR.titulo}</h2>
            {CASO_AUDITOR.parrafos.map((parrafo, i) => (
              <p class={`texto ${i === CASO_AUDITOR.parrafos.length - 1 ? "texto-fuerte" : ""}`}>
                {parrafo}
              </p>
            ))}
          </div>
          <FlujoExpediente />
          <blockquote class="caso-cita" data-reveal>
            Ya no eres un simple auditor. Eres un <span class="hl">auditor con poderes</span>.
          </blockquote>
        </div>
      </div>
    </section>

    <section>
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">MODALIDAD <b>01</b> · EL TALLER</h2></div>
        <div class="mensual" data-reveal>
          <div class="mensual-info">
            <h2 class="titulo-lg">{TALLER.nombre}</h2>
            {edicion && (
              <div class="edicion" data-edicion data-vence={edicion.inicio}>
                <p class="folio">PRÓXIMA <b>EDICIÓN</b></p>
                <p class="edicion-fecha">{fechaDeEdicion(edicion)}</p>
                <p class="edicion-ritmo">{edicion.ritmo}, de {edicion.horario}</p>
              </div>
            )}
            <p class="edicion-aviso" data-sin-edicion hidden={Boolean(edicion)}>
              Se abre una edición al mes y la fecha se anuncia por correo.
              Déjame tus datos aquí abajo y te aviso en cuanto se abra la
              siguiente, antes de que se llene.
            </p>
            <p class="precio"><b>{TALLER.precio}</b> <span>por persona · {TALLER.duracion}</span></p>
            <ul class="incluye">
              {TALLER.incluye.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="btn btn-primary" href="#precalificacion">
              {edicion ? "Quiero mi lugar en esta edición" : "Avísame de la próxima edición"}
            </a>
          </div>
          <div class="temario">
            <p class="folio temario-titulo">TEMARIO · 8 HORAS</p>
            {TALLER.temario.map((bloque) => (
              <div class="temario-bloque">
                <h3>{bloque.bloque}</h3>
                <p>{bloque.temas}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container-default">
        <div class="sec-head"><h2 class="folio">MODALIDAD <b>02</b> · EMPRESAS Y DESPACHOS</h2></div>
        <div class="dos-cols" data-reveal>
          <div>
            <h2 class="titulo-lg">{EMPRESARIAL.nombre}</h2>
            <p class="texto">{EMPRESARIAL.descripcion}</p>
            <ul class="puntos">
              {EMPRESARIAL.puntos.map((punto) => (
                <li>{punto}</li>
              ))}
            </ul>
            <a class="btn btn-ghost" href="#precalificacion">Llenar el formulario y agendar llamada</a>
          </div>
          <div>
            <h2 class="titulo-lg">{ORGANIZACIONES.nombre}</h2>
            <p class="texto">{ORGANIZACIONES.descripcion}</p>
            <ul class="puntos">
              {ORGANIZACIONES.puntos.map((punto) => (
                <li>{punto}</li>
              ))}
            </ul>
            <a class="btn btn-ghost" href="#precalificacion">Platiquemos el modelo</a>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container-default" data-reveal>
        <FormCapacitacion />
      </div>
    </section>

    <section>
      <div class="container-narrow">
        <div class="sec-head"><h2 class="folio">PREGUNTAS <b>DIRECTAS</b></h2></div>
        <FaqBlock items={FAQ_CAPACITACION} />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 3.4rem 0;
  }
  .encabezado {
    padding-top: 4.5rem;
  }
  .caso {
    display: grid;
    gap: 2.2rem;
  }
  .caso-texto .texto {
    max-width: 68ch;
  }
  .texto-fuerte {
    color: var(--color-ink);
    font-weight: 500;
  }
  .caso-cita {
    margin: 1.8rem 0 0;
    font-family: var(--font-serif-detail);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--color-ink);
    text-align: center;
  }
  .mensual {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .mensual {
      grid-template-columns: 1fr;
    }
  }
  /* La fecha es lo primero que busca quien ya decidió: va antes del precio. */
  .edicion {
    margin: 1.2rem 0 1.4rem;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .edicion-fecha {
    margin: 0.5rem 0 0.3rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .edicion-ritmo {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .edicion-aviso {
    margin: 1.2rem 0 1.4rem;
    padding-left: 1.2rem;
    border-left: 3px solid var(--color-line);
    font-size: 0.94rem;
    color: var(--color-ink-soft);
    max-width: 46ch;
  }
  .precio {
    margin: 1rem 0 1.4rem;
    font-family: var(--font-mono);
  }
  .precio b {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.02em;
  }
  .precio span {
    color: var(--color-ink-dim);
    font-size: 0.85rem;
  }
  .incluye {
    list-style: none;
    padding: 0;
    margin: 0 0 1.8rem;
  }
  .incluye li {
    padding: 0.55rem 0 0.55rem 1.6rem;
    position: relative;
    color: var(--color-ink-soft);
    border-bottom: 1px solid var(--color-line);
    font-size: 0.96rem;
  }
  .incluye li::before {
    content: "✓";
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
  }
  .temario {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    box-shadow: 6px 6px 0 var(--color-line);
    padding: 1.6rem 1.8rem;
  }
  .temario-titulo {
    display: block;
    margin-bottom: 1.1rem;
  }
  .temario-bloque {
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-line);
  }
  .temario-bloque h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }
  .temario-bloque p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .dos-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 900px) {
    .dos-cols {
      grid-template-columns: 1fr;
    }
  }
  .texto {
    color: var(--color-ink-soft);
    margin: 0.9rem 0 1.1rem;
    max-width: 52ch;
  }
  .puntos {
    list-style: none;
    padding: 0;
    margin: 0 0 1.6rem;
  }
  .puntos li {
    padding: 0.45rem 0 0.45rem 1.6rem;
    position: relative;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
  .puntos li::before {
    content: "·";
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    color: var(--color-accent);
  }
</style>

<script>
  /*
   * Red de seguridad contra la fecha vencida. El sitio es estático: si la
   * edición pasa y nadie vuelve a desplegar, el HTML seguiría anunciándola.
   * Aquí se comprueba en el navegador y, si ya pasó, se cambia por el aviso.
   * Sin JS queda lo que decidió el build, que era correcto al construir.
   */
  const edicion = document.querySelector<HTMLElement>("[data-edicion]");
  const aviso = document.querySelector<HTMLElement>("[data-sin-edicion]");

  if (edicion && aviso) {
    const vence = edicion.dataset.vence;
    // Fin del día de inicio, hora del centro de México.
    if (vence && new Date(`${vence}T23:59:59-06:00`) < new Date()) {
      edicion.hidden = true;
      aviso.hidden = false;
    }
  }
</script>

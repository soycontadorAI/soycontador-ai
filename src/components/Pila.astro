---
/**
 * La pila del día: las tareas de una mañana cayendo una sobre otra, como
 * pólizas que se despachan, y al asentarse sale de ahí la fila de colegas.
 *
 * Ocupa la mitad derecha del hero. Sustituye a la póliza (ver design/DESIGN.md):
 * la póliza argumentaba una reclasificación de horas, y esto argumenta el
 * reparto real del trabajo. Las tres primeras las cierra la máquina en verde;
 * la última la cierras tú, y por eso su marca va en tinta. Ese contraste es el
 * argumento entero, así que no se toca.
 *
 * Coreografía tomada de zig.ai (tarjetas escalonadas que entran de una en una
 * y rematan en una pila de avatares), pero NO su acabado: allá la sombra es
 * difusa y el radio grande, y aquí manda la sombra dura desplazada del sistema.
 *
 * Arranca sola al cargar, sin IntersectionObserver: está sobre el pliegue y
 * esperar al observador cuesta LCP. Solo se animan opacity y transform.
 */

interface Tarea {
  hora: string;
  titulo: string;
  pie: string;
  /** Quién la cerró. "tu" cambia la marca a tinta y la entrada de lado. */
  quien: "ia" | "tu";
  dato: string;
}

/**
 * Un lugar en la fila. Sin `foto` se dibuja la silueta de "sin foto de
 * perfil", que es lo que se ve en cualquier red social cuando alguien no
 * subió una. Mezclar retratos y siluetas es deliberado: así se ve una fila
 * de cuentas de personas, no una tira de fotos de catálogo.
 */
interface Persona {
  foto?: string;
}

interface Props {
  tareas: Tarea[];
  remate: string;
  personas: Persona[];
  /**
   * Cuántos más. Opcional Y SIN VALOR POR DEFECTO a propósito: si no se pasa
   * un número, la ficha no se dibuja. La cifra tiene que ser una que se pueda
   * sostener si alguien pregunta de dónde sale.
   */
  cuantos?: string;
}

const { tareas, remate, personas, cuantos } = Astro.props;

const ICONO = {
  ia: `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3.5h7.5L20 8v12.5H8z"/><path d="M15 3.5V8h5"/><path d="M4.5 6.5v14h11"/></svg>`,
  tu: `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c4-1 6.5-3 9-7"/><path d="M14.5 4.5 19 9l-8.5 8.5-4.5.5.5-4.5z"/></svg>`,
};
---

<div class="pila">
  {tareas.map((t, i) => (
    <article class:list={["tarjeta", t.quien]} style={`--i:${i}`}>
      <span class="cuadro" aria-hidden="true" set:html={ICONO[t.quien]} />
      <span class="cuerpo">
        <span class="hora">{t.hora}</span>
        <span class="titulo">{t.titulo}</span>
        <span class="pie">{t.pie}</span>
      </span>
      <span class="cierre">
        <span class="dato">{t.dato}</span>
        <span class="check" aria-hidden="true"></span>
      </span>
    </article>
  ))}

  <div class="remate">
    <span class="avatares" aria-hidden="true">
      {personas.map((p, i) => (
        <span class="av" style={`--n:${i}`}>
          {p.foto ? (
            /* eager y con medidas: están sobre el pliegue, y sin width/height
               declarados cada una empujaría el layout al cargar. */
            <img src={p.foto} alt="" width="30" height="30" loading="eager" decoding="async" />
          ) : (
            <svg viewBox="0 0 30 30" class="silueta">
              <circle cx="15" cy="11.4" r="4.9" />
              <path d="M15 18.2c-5.1 0-9.2 3.2-9.2 7.1V30h18.4v-4.7c0-3.9-4.1-7.1-9.2-7.1z" />
            </svg>
          )}
        </span>
      ))}
      {cuantos && <span class="av mas" style={`--n:${personas.length}`}>{cuantos}</span>}
    </span>
    <p class="remate-txt">{remate}</p>
  </div>
</div>

<style>
  .pila {
    display: grid;
    gap: 0.5rem;
  }

  /* Acabado del sistema: sombra dura desplazada y radio 8. La difusa lee a
     SaaS genérico, y la seriedad es parte de lo que se vende. */
  .tarjeta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 0.95rem;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: 4px 4px 0 var(--color-line);
  }
  /* La rotación mínima es lo que las vuelve una pila y no una lista. Se queda
     en el estado final: sin ella el bloque se endereza y pierde la idea. */
  .tarjeta:nth-of-type(1) { rotate: -0.6deg; }
  .tarjeta:nth-of-type(2) { rotate: 0.5deg; }
  .tarjeta:nth-of-type(3) { rotate: -0.35deg; }
  .tarjeta:nth-of-type(4) { rotate: 0.7deg; }

  .cuerpo {
    display: grid;
    gap: 0.08rem;
    min-width: 0;
  }
  .hora {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-dim);
  }
  .titulo {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .pie {
    font-size: 0.74rem;
    line-height: 1.35;
    color: var(--color-ink-dim);
  }
  .cuadro {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink-dim);
  }
  .tarjeta.ia .cuadro {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .tarjeta.tu .cuadro {
    background: var(--color-accent-soft);
    color: var(--color-ink);
  }

  .cierre {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .dato {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-ink-soft);
  }
  .tarjeta.ia .dato { color: var(--color-accent); }
  .tarjeta.tu .dato { color: var(--color-ink); font-weight: 700; }

  /* La marca de cerrado. Verde cuando lo cerró la máquina, TINTA cuando lo
     cerraste tú: el verde marca acción de la IA y no todo lo cerrado es suyo.
     Ese contraste es el argumento del bloque. */
  .check {
    position: relative;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
  .tarjeta.tu .check { background: var(--color-ink); }
  .check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 4.5px;
    width: 4px;
    height: 7px;
    border: solid var(--color-accent-contrast);
    border-width: 0 2px 2px 0;
    transform: rotate(43deg);
  }

  .remate {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-line-strong);
  }
  .remate-txt {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .avatares {
    display: flex;
    flex: none;
  }
  .av {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    margin-left: -8px;
    border: 2px solid var(--color-surface-raised);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    color: var(--color-ink-soft);
    overflow: hidden;
  }
  .av:first-child { margin-left: 0; }
  .av img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* La silueta se dibuja en gris medio sobre el gris de superficie: tiene que
     leerse como hueco, no como una figura más de la fila. */
  .silueta {
    width: 100%;
    height: 100%;
    display: block;
    fill: #b6c2d4;
  }
  .av.mas {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  /* En pantallas chicas la hora estorba más de lo que aporta: es ambientación,
     no dato, y el ancho lo necesita el título. */
  @media (max-width: 420px) {
    .tarjeta {
      gap: 0.65rem;
      padding: 0.7rem 0.8rem;
    }
    .hora { display: none; }
    .titulo { font-size: 0.86rem; }
  }

  /* -------------------------------------------------------------------
   * Coreografía. Caen una sobre otra y, al asentarse la pila, sale de ahí
   * la fila de colegas. El estado final es el que está escrito arriba: quien
   * llegue sin animación ve la pila completa.
   * ------------------------------------------------------------------- */
  .tarjeta {
    animation: cae 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) backwards;
    animation-delay: calc(0.35s + var(--i, 0) * 0.38s);
  }
  .remate {
    animation: entra 0.6s ease-out 2.1s backwards;
  }
  .av {
    animation: brinca 0.4s cubic-bezier(0.34, 1.4, 0.64, 1) backwards;
    animation-delay: calc(2.5s + var(--n, 0) * 0.08s);
  }

  @keyframes cae {
    from {
      opacity: 0;
      transform: translate3d(0, -1.4rem, 0) scale(1.03);
    }
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translate3d(0, 0.6rem, 0);
    }
  }
  @keyframes brinca {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .remate,
    .av {
      animation: none;
    }
  }
</style>

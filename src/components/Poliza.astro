---
/**
 * La póliza: tarjeta con tabla contable y doble raya de suma bajo el total.
 * Elemento de firma de la identidad (ver design/DESIGN.md).
 *
 * Soporta dos formas:
 *
 * - Una columna (solo cargo). La original.
 * - Partida doble (cargo y abono), que es la del hero: un contador detecta a la
 *   primera que una póliza sin contrapartida no es una póliza, es una lista de
 *   quejas. Con las dos columnas el bloque dice lo que quiere decir: el tiempo
 *   no se crea ni se destruye, se reclasifica.
 */

interface Fila {
  concepto: string;
  cargo?: string;
  abono?: string;
  /** Sangra el concepto: marca que la partida cuelga de la de arriba. */
  detalle?: boolean;
}

interface Props {
  folio: string;
  titulo: string;
  columnaCargo?: string;
  /** Si viene, la tabla se dibuja a dos columnas. */
  columnaAbono?: string;
  filas: Fila[];
  total: Fila;
  nota?: string;
  /** Foto circular en el encabezado (ruta pública) */
  foto?: string;
  fotoAlt?: string;
}

const {
  folio,
  titulo,
  columnaCargo = "Cargo",
  columnaAbono,
  filas,
  total,
  nota,
  foto,
  fotoAlt,
} = Astro.props;

const dosColumnas = Boolean(columnaAbono);
---

<div class="poliza">
  <div class="poliza-head">
    <span class="folio">{folio} · {titulo}</span>
    {foto && (
      <span class="foto"><img src={foto} alt={fotoAlt ?? ""} width="44" height="44" loading="lazy" /></span>
    )}
  </div>
  <table>
    <thead>
      <tr>
        <th>Concepto</th>
        <th class="num">{columnaCargo}</th>
        {dosColumnas && <th class="num">{columnaAbono}</th>}
      </tr>
    </thead>
    <tbody>
      {filas.map((fila) => (
        <tr>
          <td class={fila.detalle ? "detalle" : ""}>{fila.concepto}</td>
          <td class="num">{fila.cargo ?? ""}</td>
          {dosColumnas && <td class="num">{fila.abono ?? ""}</td>}
        </tr>
      ))}
      <tr class="total">
        <td>{total.concepto}</td>
        <td class="num">{total.cargo ?? ""}</td>
        {dosColumnas && <td class="num">{total.abono ?? ""}</td>}
      </tr>
    </tbody>
  </table>
  {nota && <p class="poliza-foot">{nota}</p>}
</div>

<style>
  .poliza {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    box-shadow: 6px 6px 0 var(--color-line);
    overflow: hidden;
  }
  .poliza-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.2rem;
    border-bottom: 1px solid var(--color-line-strong);
    background: var(--color-surface);
  }
  .foto {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    border: 1.5px solid var(--color-line-strong);
    flex: none;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  th {
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.66rem;
    color: var(--color-ink-dim);
    padding: 0.7rem 1.2rem 0.4rem;
    border-bottom: 1px solid var(--color-line);
  }
  td {
    padding: 0.62rem 1.2rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-soft);
  }
  /* Las partidas que cuelgan de la de arriba se sangran, como en libros. */
  td.detalle {
    padding-left: 2rem;
  }
  td.num,
  th.num {
    text-align: right;
    white-space: nowrap;
  }
  td.num {
    font-weight: 500;
    color: var(--color-ink);
  }
  tr.total td {
    border-bottom: none;
    border-top: 1.5px solid var(--color-line-strong);
    box-shadow: 0 3px 0 -1px var(--color-line-strong);
    font-weight: 700;
    color: var(--color-ink);
    padding-block: 0.8rem;
  }
  tr.total td.num {
    color: var(--color-accent);
    font-size: 1rem;
  }
  .poliza-foot {
    padding: 0.7rem 1.2rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-ink-dim);
  }
  @media (max-width: 420px) {
    table {
      font-size: 0.74rem;
    }
    td,
    th {
      padding-inline: 0.8rem;
    }
    td.detalle {
      padding-left: 1.4rem;
    }
  }
</style>

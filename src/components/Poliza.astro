---
/**
 * La póliza: tarjeta con tabla contable y doble raya de suma bajo el total.
 * Elemento de firma de la identidad (ver design/DESIGN.md).
 *
 * Soporta dos formas:
 *
 * - Una columna (solo cargo). La original.
 * - Partida doble (cargo y abono), que es la del hero: un contador detecta a la
 *   primera que una póliza sin contrapartida no es una póliza, es una lista de
 *   quejas. Con las dos columnas el bloque dice lo que quiere decir: el tiempo
 *   no se crea ni se destruye, se reclasifica.
 */

interface Fila {
  concepto: string;
  cargo?: string;
  abono?: string;
  /** Sangra el concepto: marca que la partida cuelga de la de arriba. */
  detalle?: boolean;
}

interface Props {
  folio: string;
  /**
   * Coreografía de registro: las partidas entran, se asientan, hay una pausa
   * con la columna de cargo vacía (esa incomodidad solo la siente un contador,
   * y es el activo del bloque) y entra la contrapartida.
   */
  animada?: boolean;
  titulo: string;
  columnaCargo?: string;
  /** Si viene, la tabla se dibuja a dos columnas. */
  columnaAbono?: string;
  filas: Fila[];
  total: Fila;
  nota?: string;
  /** Foto circular en el encabezado (ruta pública) */
  foto?: string;
  fotoAlt?: string;
}

const {
  folio,
  titulo,
  animada = false,
  columnaCargo = "Cargo",
  columnaAbono,
  filas,
  total,
  nota,
  foto,
  fotoAlt,
} = Astro.props;

const dosColumnas = Boolean(columnaAbono);
---

<div class:list={["poliza ficha ficha-dura", { animada, doble: dosColumnas }]}>
  <div class="poliza-head">
    <span class="folio">{folio} · {titulo}</span>
    {foto && (
      <span class="foto"><img src={foto} alt={fotoAlt ?? ""} width="44" height="44" loading="lazy" /></span>
    )}
  </div>
  <table>
    <thead>
      <tr>
        <th>Concepto</th>
        <th class="num">{columnaCargo}</th>
        {dosColumnas && <th class="num">{columnaAbono}</th>}
      </tr>
    </thead>
    <tbody>
      {filas.map((fila, i) => (
        <tr class:list={{ detalle: fila.detalle }} style={`--i:${i}`}>
          <td class={fila.detalle ? "detalle" : ""}>{fila.concepto}</td>
          <td class="num">{fila.cargo ?? ""}</td>
          {dosColumnas && <td class="num">{fila.abono ?? ""}</td>}
        </tr>
      ))}
      {animada && dosColumnas && (
        <tr class="pausa" aria-hidden="true">
          <td colspan={dosColumnas ? 3 : 2}><span class="pausa-nota">// falta la contrapartida</span></td>
        </tr>
      )}
      <tr class="total">
        <td>{total.concepto}</td>
        <td class="num">{total.cargo ?? ""}</td>
        {dosColumnas && <td class="num">{total.abono ?? ""}</td>}
      </tr>
    </tbody>
  </table>
  {nota && <p class="poliza-foot">{nota}</p>}
</div>

<style>
  .poliza {
    overflow: hidden;
  }
  .poliza-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.2rem;
    border-bottom: 1px solid var(--color-line-strong);
    background: var(--color-surface);
  }
  .foto {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    border: 1.5px solid var(--color-line-strong);
    flex: none;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  th {
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.66rem;
    color: var(--color-ink-dim);
    padding: 0.7rem 1.2rem 0.4rem;
    border-bottom: 1px solid var(--color-line);
  }
  td {
    padding: 0.62rem 1.2rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-soft);
  }
  /* Las partidas que cuelgan de la de arriba se sangran, como en libros. */
  td.detalle {
    padding-left: 2rem;
  }
  td.num,
  th.num {
    text-align: right;
    white-space: nowrap;
  }
  td.num {
    font-weight: 500;
    color: var(--color-ink);
  }
  tr.total td {
    border-bottom: none;
    border-top: 1.5px solid var(--color-line-strong);
    box-shadow: 0 3px 0 -1px var(--color-line-strong);
    font-weight: 700;
    color: var(--color-ink);
    padding-block: 0.8rem;
  }
  tr.total td.num {
    color: var(--color-accent);
    font-size: 1rem;
  }
  .poliza-foot {
    padding: 0.7rem 1.2rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-ink-dim);
  }
  @media (max-width: 420px) {
    table {
      font-size: 0.74rem;
    }
    td,
    th {
      padding-inline: 0.8rem;
    }
    td.detalle {
      padding-left: 1.4rem;
    }
  }

  /* ---------------------------------------------------------------------
   * Coreografía de registro (solo con .animada)
   *
   * Sin JS a propósito: el hero está arriba del pliegue y esconderlo con
   * data-reveal para esperar al observador cuesta LCP. Con animaciones CSS
   * arranca sola, corre una vez y no vuelve.
   *
   * Solo se animan transform, opacity y clip-path. Nunca width, top ni height:
   * eso obliga a recalcular el layout en cada cuadro y en un celular de gama
   * media se ve a tirones.
   *
   * El estado FINAL es el que está escrito arriba. Las animaciones parten de un
   * estado desplazado y regresan a ese; quien llegue sin animación (JS caído,
   * reduced-motion, un lector de pantalla) ve la póliza completa y cuadrada.
   * --------------------------------------------------------------------- */

  /* Fase 1 y 2: las tres partidas de abono entran escalonadas y se asientan.
     Sin palomita: son sangrado, no logros. */
  .animada.doble tbody tr.detalle td {
    animation: partida-entra 0.75s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(0.35s + var(--i, 0) * 0.35s);
  }
  /* El CARGO entra en la fase 4, después de la pausa: es la contrapartida y por
     eso llega al final. Se distingue por clase y no por :first-child, porque
     los :not() de la regla de arriba pesan más que un :first-child y la dejaban
     sin efecto: el cargo aparecía desde el primer cuadro y se perdía el hueco,
     que es todo el chiste del bloque. */
  .animada.doble tbody tr:not(.detalle):not(.total):not(.pausa) td {
    animation: contrapartida-entra 0.7s cubic-bezier(0.22, 1, 0.36, 1) 3.2s backwards;
  }

  /* Fase 3: la pausa. La columna de cargo está visiblemente vacía y se teclea
     el comentario. Es el beat que hace la pieza: solo un contador siente el
     hueco. Se va cuando entra la contrapartida. */
  /* Nace y muere invisible: la nota solo existe mientras dura el hueco. Sin
     esto se quedaba pegada después de que entra la contrapartida, o sea
     señalando un problema ya resuelto. */
  .animada tr.pausa td {
    border-bottom-color: transparent;
    padding-block: 0.3rem;
    opacity: 0;
    animation: pausa-va-y-viene 3.9s linear;
  }
  .pausa-nota {
    display: inline-block;
    font-size: 0.7rem;
    color: var(--color-ink-dim);
    border-right: 1px solid var(--color-ink-dim);
    animation:
      tecleo 0.7s steps(24, end) 2.05s backwards,
      cursor 0.8s step-end 2.05s 3;
  }

  /* Fase 4: los totales se encienden juntos. 20 h = 20 h. */
  .animada.doble tr.total td {
    animation: total-cuadra 0.5s ease-out backwards;
    animation-delay: 3.9s;
  }

  @keyframes partida-entra {
    from {
      opacity: 0;
      transform: translate3d(2.2rem, -0.6rem, 0) rotate(1.6deg);
    }
  }
  @keyframes contrapartida-entra {
    from {
      opacity: 0;
      transform: translate3d(-2.2rem, 0, 0);
    }
  }
  @keyframes total-cuadra {
    from {
      opacity: 0;
    }
  }
  @keyframes pausa-va-y-viene {
    0% { opacity: 0; }
    /* Visible desde que se teclea (2.05s) hasta que entra el cargo (3.2s). */
    50%, 82% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes tecleo {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes cursor {
    50% { border-right-color: transparent; }
  }

  /* Quien pidió menos movimiento ve el estado final, sin excepción. */
  @media (prefers-reduced-motion: reduce) {
    .animada tbody td,
    .animada .pausa-nota {
      animation: none !important;
    }
    .animada tr.pausa {
      display: none;
    }
  }

  /* Los bloques bajo el pliegue esperan a entrar en pantalla: si no, la
     coreografía termina sola mientras el visitante sigue arriba y solo ve el
     resultado. Se apoya en el data-reveal que ya existe.

     La condición incluye html.js-reveal a propósito: sin JavaScript esa clase
     nunca se pone, así que nada queda pausado y la animación corre al cargar.
     Pausar sin JS dejaría el contenido congelado en opacidad 0, que es
     exactamente lo que la regla 3 prohíbe. */
  :global(html.js-reveal [data-reveal]:not(.is-visible)) .animada tbody td,
  :global(html.js-reveal [data-reveal]:not(.is-visible)) .animada .pausa-nota {
    animation-play-state: paused;
  }
</style>

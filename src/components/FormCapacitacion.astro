---
/**
 * Precalificación de capacitación (el taller, empresarial u
 * organizaciones). Formulario extendido a propósito: quien llega aquí ya
 * tiene interés, así que pedimos el contexto completo ANTES de la llamada.
 * POST a /api/lead con campos personalizados de Sendy.
 */

import FormCard from "./FormCard.astro";
import { calendarioDe } from "../lib/site";

interface Props {
  /**
   * "todas" es /capacitacion: el visitante elige modalidad porque puede venir
   * por cualquiera de las tres. "despacho" es /despachos, donde la modalidad
   * ya la decidió la página: preguntarla otra vez es pedirle al socio que
   * repita algo que ya dijo al entrar, y de paso le abre la puerta a elegir
   * mal. Ahí el rol va fijo y las opciones de tamaño arrancan en 2.
   */
  variante?: "todas" | "despacho";
}

const { variante = "todas" } = Astro.props;
const esDespacho = variante === "despacho";

/**
 * El enlace para agendar solo aparece al enviar (decisión de Israel): es el
 * momento de mayor intención y ya calificó. Si no hay agenda configurada, el
 * bloque no se renderiza y el flujo termina en el formulario.
 */
const calendario = calendarioDe("capacitacion");
---

<FormCard
  id="precalificacion"
  folio={esDespacho ? "DESP-02" : "CAP-01"}
  etiqueta={esDespacho ? "DIAGNÓSTICO" : "PRECALIFICACIÓN"}
  titulo={esDespacho ? "Cuéntame de tu despacho" : "Cuéntame de tu equipo antes de agendar"}
  intro={esDespacho
    ? "Cinco minutos. Con esto llego a la llamada conociendo tu operación, y los treinta minutos se van en sacar tus números, no en presentarme. Si por lo que leo esto no es para tu despacho, te lo digo por correo y no gastamos la llamada."
    : "Con esto llego a la llamada conociendo tu operación y la reunión se va directo a lo importante: qué automatizar primero y cómo se ve el programa para tu caso."}
  introMax="58ch"
>
  <form method="post" action="/api/lead" data-cap>
    <div class="campo">
      <label for="cap-nombre">Tu nombre *</label>
      <input id="cap-nombre" type="text" name="nombre" required autocomplete="name" />
    </div>
    <div class="campo">
      <label for="cap-email">Tu correo *</label>
      <input id="cap-email" type="email" name="email" required placeholder="tu@correo.com" autocomplete="email" />
    </div>
    <div class="campo">
      <label for="cap-whatsapp">WhatsApp (opcional)</label>
      <input id="cap-whatsapp" type="tel" name="whatsapp" placeholder="+52 " autocomplete="tel" />
    </div>
    <div class="campo">
      <label for="cap-empresa">Empresa, despacho u organización *</label>
      <input id="cap-empresa" type="text" name="empresa" required autocomplete="organization" />
    </div>
    {esDespacho ? (
      <input type="hidden" name="rol" value="Capacitación: empresarial" />
    ) : (
      <div class="campo">
        <label for="cap-modalidad">¿Qué modalidad te interesa?</label>
        <select id="cap-modalidad" name="rol">
          <option value="Capacitación: taller">El taller (mi lugar individual)</option>
          <option value="Capacitación: empresarial">Capacitación para mi empresa o despacho</option>
          <option value="Capacitación: organización">Licenciar el taller para mi organización o comunidad</option>
        </select>
      </div>
    )}
    <div class="campo">
      <label for="cap-equipo">¿Cuántas personas son?</label>
      <select id="cap-equipo" name="equipo">
        {!esDespacho && <option value="Solo yo">Solo yo</option>}
        <option value="2-5">2 a 5</option>
        <option value="6-20">6 a 20</option>
        <option value="21-50">21 a 50</option>
        <option value="50+">Más de 50</option>
      </select>
    </div>
    <div class="campo">
      <label for="cap-nivel">¿Qué tanto usan IA hoy?</label>
      <select id="cap-nivel" name="nivelIA">
        <option value="No la usamos">Todavía no la usamos</option>
        <option value="Probamos sin método">La probamos, pero sin método</option>
        <option value="Uso diario">La usamos casi a diario</option>
      </select>
    </div>
    <div class="campo">
      <label for="cap-cuando">¿Para cuándo lo necesitas?</label>
      <select id="cap-cuando" name="cuando">
        <option value="Lo antes posible">Lo antes posible</option>
        <option value="Este trimestre">En los próximos 3 meses</option>
        <option value="Explorando">Apenas estoy explorando</option>
      </select>
    </div>
    <div class="campo campo-full">
      <label for="cap-mensaje">
        {esDespacho ? "¿Dónde se le va el tiempo a tu equipo hoy? *" : "¿Qué procesos te gustaría automatizar? *"}
      </label>
      <textarea
        id="cap-mensaje"
        name="mensaje"
        rows="3"
        required
        maxlength="500"
        placeholder="Ej. descargamos CFDI a mano para 40 clientes y las conciliaciones nos toman una semana cada cierre…"></textarea>
    </div>
    <div class="campo-full consentimiento">
      <label>
        <input type="checkbox" name="newsletter" value="si" />
        <span>
          Me uno al newsletter: una idea de IA fiscal a la semana, avisos del
          live y de los talleres. <b>(Opcional)</b>
        </span>
      </label>
    </div>
    <input type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-hp" />
    <div class="campo-full form-envio">
      <button type="submit" class="btn btn-primary">
        {esDespacho ? "Enviar y agendar el diagnóstico" : "Enviar y agendar llamada"}
      </button>
      <small data-cap-msg>
        {esDespacho
          ? "Te llega el resumen a tu correo. Te contesto en menos de 48 horas hábiles."
          : "Te llega el resumen a tu correo y de ahí agendamos la llamada."}
      </small>
    </div>
  </form>
  {calendario && (
    <p class="cap-calendario" data-agenda hidden>
      <a class="btn btn-primary" href={calendario} target="_blank" rel="noopener">
        Agendar la llamada ahora
      </a>
    </p>
  )}
</FormCard>

<style>
  /* La entrada de este formulario es más larga: 38ch contra los 34 del otro. */
  .form-envio small {
    max-width: 38ch;
  }
  .cap-calendario {
    margin: 1.2rem 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .cap-calendario a {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>

<script>
  import { montarLead } from "../lib/enviar-lead";

  montarLead({
    formulario: "[data-cap]",
    mensaje: "[data-cap-msg]",
    evento: "diagnostico_enviado",
    carga: (d) => ({
      nombre: d.get("nombre"),
      email: d.get("email"),
      whatsapp: d.get("whatsapp"),
      empresa: d.get("empresa"),
      rol: d.get("rol"),
      equipo: d.get("equipo"),
      nivelIA: d.get("nivelIA"),
      cuando: d.get("cuando"),
      mensaje: d.get("mensaje"),
      interes: "Capacitación",
    }),
    /* El de mayor valor del sitio. El tamaño del equipo va porque es lo
       que separa un despacho de un contador solo, y esa diferencia es la
       que decide si vale la pena empujar /despachos. */
    medida: (d) => ({
      modalidad: String(d.get("rol") ?? ""),
      equipo: String(d.get("equipo") ?? ""),
      cuando: String(d.get("cuando") ?? ""),
    }),
    recibido: (boletin, conAgenda) =>
      conAgenda
        ? `Recibido. Te mandé el resumen a tu correo.${boletin} Aparta tu horario aquí:`
        : `Recibido. Te mandé el resumen a tu correo y te contacto para agendar.${boletin}`,
  });
</script>

---
import { PERSONA, SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  /* Fechas del contenido, en ISO 8601 (2026-09-23 o con hora). LinkedIn las
     lee para la tarjeta; sin ellas el inspector marca "no publication date
     found". Son opcionales: una página de servicio no siempre tiene fecha. */
  publicado?: string;
  actualizado?: string;
}

const {
  title,
  description = SITE.descriptionDefault,
  image = "/og-default.png",
  canonical,
  type = "website",
  noindex = false,
  publicado,
  actualizado,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.name}` : SITE.titleDefault;
const url = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const imageUrl = new URL(image, SITE.url).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />

<!--
  El autor va SIEMPRE, en las dos formas. LinkedIn lo busca en `author` o en
  `article:author` y, si no encuentra ninguna, su inspector marca "no author
  found" y la tarjeta sale sin firma. Lo confirmó el inspector con /despachos
  el 2026-09-22.

  El nombre sale de PERSONA en site.ts, que es la fuente única de la entidad:
  el mismo dato que alimenta el JSON-LD y llms.txt. No se escribe a mano aquí.
-->
<meta name="author" content={PERSONA.nombre} />
<meta property="article:author" content={PERSONA.nombre} />

{publicado && <meta property="article:published_time" content={publicado} />}
{(actualizado ?? publicado) && (
  <meta property="article:modified_time" content={actualizado ?? publicado} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

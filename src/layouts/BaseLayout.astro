---
import "../styles/global.css";

import JsonLd from "../components/JsonLd.astro";
import SEO from "../components/SEO.astro";
import { FOOTER_LINKS, NAV, NAV_PAGINAS, SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  /** Grafo JSON-LD ya armado con graph(...) de lib/schema.ts */
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type, noindex, jsonLd } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {title} {description} {image} {type} {noindex} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <nav class="container-default site-nav" aria-label="Principal">
        <a class="site-logo" href="/">soycontador<span>.ai</span></a>
        <ul class="site-links">
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
        <a class="site-cta" href="/contacto">Agenda un diagnóstico</a>
      </nav>
    </header>

    <slot />

    <script>
      // Reveal on scroll: html.js-reveal activa el ocultamiento (así el
      // contenido nunca queda invisible sin JS).
      document.documentElement.classList.add("js-reveal");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>

    <footer class="site-footer">
      <div class="container-default">
        <nav class="site-foot-paginas" aria-label="Páginas del sitio">
          <ul class="site-links">
            {NAV_PAGINAS.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="site-foot">
          <small>soycontador.ai · Israel Castro · Hecho en México · {year}</small>
          <ul class="site-links">
            {FOOTER_LINKS.map((item) => (
              <li>
                <a
                  href={item.href}
                  rel={item.href.startsWith("http") ? "me noopener" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Chrome de la identidad "Libro mayor × terminal" (ver design/DESIGN.md) */
  .site-header {
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }
  .site-logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .site-logo span {
    color: var(--color-accent);
  }
  .site-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .site-links a {
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .site-links a:hover {
    color: var(--color-accent);
  }
  .site-cta {
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-sm);
  }
  .site-cta:hover {
    background: var(--color-accent-hover);
  }
  .site-footer {
    background: var(--color-surface-raised);
    border-top: 1.5px solid var(--color-line-strong);
    margin-top: 4rem;
  }
  .site-foot-paginas {
    border-bottom: 1px solid var(--color-line);
    padding-block: 1.4rem;
  }
  .site-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: 2rem 2.5rem;
  }
  .site-foot small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-dim);
  }
  @media (max-width: 760px) {
    .site-nav .site-links {
      display: none;
    }
  }
</style>
